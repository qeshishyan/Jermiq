# Docker Compose reads these settings from .env.
JERMIQ_BASE_URL=http://localhost:8080
JERMIQ_INDEXING_ENABLED=false
JERMIQ_REQUIRE_HTTPS=false
JERMIQ_PROXY_IP=127.0.0.1
# For public deployment, use your actual https:// domain and enable indexing/HTTPS.
# Set JERMIQ_PROXY_IP to the verified proxy address as seen by the container.
