@page "/products/{slug}/reviews"
@model Jermiq.Web.Pages.Products.ReviewsModel
@{ var p = Model.Product; var reviews = Model.Reviews; }
<link rel="stylesheet" href="/css/reviews.css" asp-append-version="true" />
<div class="container review-page">
<nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><a href="/products/@p.Slug">@p.Title</a><span>/</span><span>@L["Կարծիքներ"]</span></nav>
<header class="review-page-heading"><div><span class="eyebrow">@L["Գնորդների կարծիքներ"]</span><h1>@p.Title</h1><p>@L["Կիսվեք ապրանքի օգտագործման ձեր փորձով։"]</p></div><a href="/products/@p.Slug" class="btn btn-outline">← @L["Վերադառնալ ապրանքին"]</a></header>
<div class="review-page-grid"><section class="review-list-section" aria-labelledby="review-list-title"><div class="review-summary"><h2 id="review-list-title">@L["Կարծիքներ"] <span>(@reviews.Total)</span></h2>@if (reviews.AverageRating is not null) { <p><span class="review-stars" aria-hidden="true">★</span> <strong>@reviews.AverageRating.Value.ToString("0.0") / 5</strong></p> }</div>
@if (reviews.Total == 0) { <div class="review-empty"><i data-icon="message"></i><h3>@L["Դեռ հրապարակված կարծիքներ չկան"]</h3><p>@L["Կարող եք առաջինը կիսվել ձեր փորձով։"]</p></div> }
@foreach (var review in reviews.Reviews) { <article class="review-card"><header><strong>@review.Name</strong><time datetime="@DateTimeOffset.FromUnixTimeMilliseconds(review.CreatedAt).ToString("yyyy-MM-dd")">@DateTimeOffset.FromUnixTimeMilliseconds(review.CreatedAt).ToOffset(TimeSpan.FromHours(4)).ToString("dd.MM.yyyy")</time></header><p class="review-stars"><span aria-hidden="true">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span><span class="review-rating-label">@review.Rating / 5</span></p><p class="review-message">@review.Message</p></article> }
@if (reviews.Total > reviews.PageSize) { <nav class="review-pagination" aria-label="@L["Էջավորում"]">@if (reviews.Page > 1) { <a class="btn btn-outline" href="/products/@p.Slug/reviews?p=@(reviews.Page - 1)">← @L["Նախորդը"]</a> }<span>@reviews.Page / @((reviews.Total + reviews.PageSize - 1) / reviews.PageSize)</span>@if (reviews.Page * reviews.PageSize < reviews.Total) { <a class="btn btn-outline" href="/products/@p.Slug/reviews?p=@(reviews.Page + 1)">@L["Հաջորդը"] →</a> }</nav> }
</section><section class="review-form-section" aria-labelledby="review-form-title"><h2 id="review-form-title">@L["Գրել կարծիք"]</h2><p class="review-form-help">@L["Կարծիքները հրապարակվում են ստուգումից հետո։ Էլ․ փոստը չի հրապարակվում։"]</p><form id="product-review-form" data-product-slug="@p.Slug"><div class="form-grid"><label class="field full">@L["Ձեր անունը"] *<input name="name" autocomplete="name" minlength="2" maxlength="100" required /></label><label class="field full">@L["Էլ․ փոստ"]<input name="email" type="email" autocomplete="email" maxlength="200" /></label><label class="field full">@L["Գնահատական"] *<select name="rating" required><option value="">@L["Ընտրեք գնահատականը"]</option>@for (var rating = 5; rating >= 1; rating--) { <option value="@rating">@rating / 5</option> }</select></label><label class="field full">@L["Ձեր կարծիքը"] *<textarea name="message" minlength="10" maxlength="3000" rows="6" required></textarea></label><label class="checkbox-line full"><input type="checkbox" name="consent" required /><span>@L["Համաձայն եմ տվյալների մշակմանը և կարծիքի հրապարակմանը։"] <a href="/privacy">@L["Գաղտնիության պայմաններ"]</a></span></label></div><p id="review-form-error" class="error-text" role="alert" hidden></p><p id="review-form-success" class="notice" role="status" hidden></p><button type="submit" class="btn">@L["Ուղարկել կարծիքը"]</button></form></section></div></div>
@section Scripts { <script src="/js/reviews.js" asp-append-version="true" defer></script> }
