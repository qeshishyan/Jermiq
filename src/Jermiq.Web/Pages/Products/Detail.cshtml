@page "/products/{slug}"
@model Jermiq.Web.Pages.Products.DetailModel
@{ var p = Model.Product; }
<div class="container pb-16"><nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><a href="@(p.Category == "heater" ? "/catalog" : "/parts")">@(p.Category == "heater" ? L["Ջրատաքացուցիչներ"] : L["Պահեստամասեր"])</a><span>/</span><span>@p.Title</span></nav>

<div class="detail-grid"><div class="product-gallery" data-gallery>
<button type="button" class="detail-image gallery-open" aria-label="@L["Մեծացնել նկարը"]"><img id="gallery-main" src="@p.Image" alt="@p.Title" width="700" height="700" /><span class="gallery-hint">@L["Մեծացնել նկարը"] ↗</span></button>
<div class="gallery-thumbs">@foreach (var image in p.Gallery) { <button type="button" data-gallery-src="@image" aria-label="@L["Դիտել նկարը"]" aria-pressed="@(image == p.Image ? "true" : "false")"><img src="@image" alt="" width="80" height="80" loading="lazy" /></button> }</div>
<dialog class="gallery-lightbox" aria-label="@L["Ապրանքի լուսանկարներ"]"><div class="gallery-toolbar"><button type="button" data-gallery-prev aria-label="@L["Նախորդը"]">←</button><span class="gallery-counter" aria-live="polite"></span><button type="button" data-gallery-next aria-label="@L["Հաջորդը"]">→</button><button type="button" data-gallery-zoom>@L["Մեծացնել նկարը"] ＋</button><button type="button" data-gallery-close aria-label="@L["Փակել"]">✕</button></div><div class="gallery-stage"><img alt="@p.Title" /></div></dialog></div><div class="detail-copy" data-product="@SiteJson.Serialize(p)"><div class="eyebrow">@(p.Category == "heater" ? L["Ջրատաքացուցիչ"] : L["Պահեստամաս"])</div><h1>@p.Title</h1><p>@p.Description</p><div class="detail-price">@(p.Price is null ? L["Գինը՝ ճշտման փուլում"] : p.Price.Value.ToString("N0") + " ֏")</div>@if (p.PriceIsEstimate && p.Price is not null) { <p class="price-estimate">@L["Կողմնորոշիչ գին․ վերջնական արժեքը համաձայնեցվում է հայտից հետո։"]</p> }<p>@p.Availability</p>
<button type="button" class="btn" data-action="add-cart"><i data-icon="bag"></i>@(p.Price is null ? L["Հարցնել գինը"] : L["Ավելացնել պատվերին"])</button><button type="button" class="compare-button" data-action="compare-toggle" aria-pressed="false"><i data-icon="scale"></i><span>@L["Համեմատել"]</span></button>
<div class="spec-list">@if (!string.IsNullOrWhiteSpace(p.Brand)) { <div class="spec-row"><span>@L["Արտադրող"]</span><span>@p.Brand</span></div> }@if (!string.IsNullOrWhiteSpace(p.Model)) { <div class="spec-row"><span>@L["Մոդել"]</span><span>@p.Model</span></div> }@foreach (var spec in p.Specs) { <div class="spec-row"><span>@spec.Key</span><span>@spec.Value</span></div> }</div>
<button type="button" class="btn btn-outline" data-request="@(p.Category == "part" ? "part" : "question")" data-subject="@p.Title">@L["Ճշտել համապատասխանությունը"]</button></div></div>
<section class="section prose"><h2>@L["Երաշխիք"]</h2><p>@Model.Settings.Warranty</p><h2>@L["Առաքում"]</h2><p>@Model.Settings.Delivery</p><h2>@L["Սպասարկում"]</h2><p>@L["Կարող եք դիմել տեղադրման կամ հետագա սպասարկման համար։ Կատարված աշխատանքի երաշխիքը համաձայնեցվում է առանձին։"]</p><button type="button" class="btn" data-request="service" data-subject="@L["Սպասարկում՝"] @p.Title">@L["Դիմել սպասարկման"]</button></section>
<div class="section-heading"><h2>@L["Նույն բաժնից"]</h2></div><div class="catalog-grid">@foreach (var related in Model.Related) { <partial name="_ProductCard" model="related" /> }</div></div>
