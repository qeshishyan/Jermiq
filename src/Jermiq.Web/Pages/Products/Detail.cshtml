@page "/products/{slug}"
@model Jermiq.Web.Pages.Products.DetailModel
@{ var p = Model.Product; }
<div class="container pb-16"><nav class="breadcrumbs" aria-label="Էջի ուղին"><a href="/">Գլխավոր</a><span>/</span><a href="@(p.Category == "heater" ? "/catalog" : "/parts")">@(p.Category == "heater" ? "Ջրատաքացուցիչներ" : "Պահեստամասեր")</a><span>/</span><span>@p.Title</span></nav>
@if (p.Demo) { <div class="notice">Ցուցադրական ապրանք և պատկեր։ Արտադրողը, մոդելը և տեխնիկական տվյալները դեռ հաստատված չեն։</div> }
<div class="detail-grid"><div class="detail-image"><img src="@p.Image" alt="@(p.Demo ? "Ապրանքի պատկերային օրինակ" : p.Title)" width="700" height="700" /></div><div class="detail-copy" data-product="@SiteJson.Serialize(p)"><div class="eyebrow">@(p.Category == "heater" ? "Ջրատաքացուցիչ" : "Պահեստամաս")</div><h1>@p.Title</h1><p>@p.Description</p><div class="detail-price">@(p.Price is null ? "Գինը՝ ճշտման փուլում" : p.Price.Value.ToString("N0") + " ֏")</div><p>@p.Availability</p>
<button type="button" class="btn" data-action="add-cart"><i data-icon="bag"></i>@(p.Price is null ? "Հարցնել գինը" : "Ավելացնել պատվերին")</button><button type="button" class="compare-button" data-action="compare-toggle" aria-pressed="false"><i data-icon="scale"></i><span>Համեմատել</span></button>
<div class="spec-list"><div class="spec-row"><span>Արտադրող</span><span>@p.Brand</span></div><div class="spec-row"><span>Մոդել</span><span>@p.Model</span></div>@foreach (var spec in p.Specs) { <div class="spec-row"><span>@spec.Key</span><span>@spec.Value</span></div> }</div>
<button type="button" class="btn btn-outline" data-request="@(p.Category == "part" ? "part" : "question")" data-subject="@p.Title">Ճշտել համապատասխանությունը</button></div></div>
<section class="section prose"><h2>Երաշխիք</h2><p>@Model.Settings.Warranty</p><h2>Առաքում</h2><p>@Model.Settings.Delivery</p><h2>Սպասարկում</h2><p>Կարող եք դիմել տեղադրման կամ հետագա սպասարկման համար։ Կատարված աշխատանքի երաշխիքը համաձայնեցվում է առանձին։</p><button type="button" class="btn" data-request="service" data-subject="Սպասարկում՝ @p.Title">Դիմել սպասարկման</button></section>
<div class="section-heading"><h2>Նույն բաժնից</h2></div><div class="catalog-grid">@foreach (var related in Model.Related) { <partial name="_ProductCard" model="related" /> }</div></div>
