@page "/products/{slug}"
@model Jermiq.Web.Pages.Products.DetailModel
@{ var p = Model.Product; }
<div class="container store-detail-page"><nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><a href="/catalog">@L["Կատալոգ"]</a>@if (Model.Category is not null) { <span>/</span><a href="@("/catalog?category=" + Uri.EscapeDataString(Model.Category.Id))">@Model.Category.Title</a> }<span>/</span><span>@p.Title</span></nav>
<div class="detail-grid store-detail-grid"><div class="product-gallery" data-gallery><button type="button" class="detail-image gallery-open" aria-label="@L["Մեծացնել նկարը"]"><img id="gallery-main" src="@p.Image" alt="@p.Title" width="700" height="700" /><span class="gallery-hint">@L["Մեծացնել նկարը"] ↗</span></button><div class="gallery-thumbs">@foreach (var image in p.Gallery) { <button type="button" data-gallery-src="@image" aria-label="@L["Դիտել նկարը"]" aria-pressed="@(image == p.Image ? "true" : "false")"><img src="@image" alt="" width="80" height="80" loading="lazy" /></button> }</div><dialog class="gallery-lightbox" aria-label="@L["Ապրանքի լուսանկարներ"]"><div class="gallery-toolbar"><button type="button" data-gallery-prev aria-label="@L["Նախորդը"]">←</button><span class="gallery-counter" aria-live="polite"></span><button type="button" data-gallery-next aria-label="@L["Հաջորդը"]">→</button><button type="button" data-gallery-zoom>@L["Մեծացնել նկարը"] ＋</button><button type="button" data-gallery-close aria-label="@L["Փակել"]">✕</button></div><div class="gallery-stage"><img alt="@p.Title" /></div></dialog></div>
<div class="detail-copy store-detail-copy" data-product="@SiteJson.Serialize(p)"><div class="store-detail-meta"><span class="eyebrow">@(Model.Category?.Title ?? (p.Category == "heater" ? L["Ջրատաքացուցիչ"] : L["Պահեստամաս"]))</span>@if (p.IsNew) { <span class="store-badge-new">@L["Նոր"]</span> }@if (p.IsFeatured) { <span class="store-badge">@L["Առաջարկվող"]</span> }</div><h1>@p.Title</h1><div class="store-detail-code">@if (p.Sku.Length > 0) { <span>@L["Արտիկուլ"]: <strong>@p.Sku</strong></span> }@if (p.Brand.Length > 0) { <span>@p.Brand</span> }</div><p class="store-detail-description">@p.Description</p><div class="store-detail-purchase"><div class="store-product-prices"><div class="detail-price">@(p.Price is null ? L["Գինը՝ ճշտման փուլում"] : p.Price.Value.ToString("N0") + " ֏")</div>@if (p.OldPrice > p.Price && p.Price is not null) { <del>@p.OldPrice.Value.ToString("N0") ֏</del> }</div>@if (p.PriceIsEstimate && p.Price is not null) { <p class="price-estimate">@L["Կողմնորոշիչ գին․ վերջնական արժեքը համաձայնեցվում է հայտից հետո։"]</p> }<p class="stock">@p.Availability@if (p.StockQuantity is not null) { <span> · @p.StockQuantity @L["հատ"]</span> }</p><label class="store-quantity-label">@L["Քանակ"]<input class="store-quantity-input" data-product-quantity type="number" min="1" max="20" step="1" value="1" aria-label="@L["Քանակ"]" /></label><div class="actions"><button type="button" class="btn" data-action="add-cart"><i data-icon="bag"></i>@(p.Price is null ? L["Հարցնել գինը"] : L["Ավելացնել պատվերին"])</button><button type="button" class="store-detail-save" data-action="favorite-toggle" aria-pressed="false"><i data-icon="heart"></i>@L["Ընտրյալ"]</button><button type="button" class="store-detail-save" data-action="compare-toggle" aria-pressed="false"><i data-icon="scale"></i>@L["Համեմատել"]</button></div></div><div class="store-detail-services"><a href="/delivery"><i data-icon="package"></i>@L["Առաքում և ինքնավերցում"] <span>→</span></a><a href="/warranty"><i data-icon="shield"></i>@L["Երաշխիքային պայմաններ"] <span>→</span></a><a href="/payment"><i data-icon="file-check"></i>@L["Վճարման պայմաններ"] <span>→</span></a></div><button type="button" class="store-compatibility-help" data-request="@(p.Category == "part" ? "part" : "question")" data-subject="@p.Title"><i data-icon="search-check"></i>@L["Ճշտել համապատասխանությունը"] <span>↗</span></button></div></div>
<nav class="store-detail-tabs" aria-label="@L["Ապրանքի մանրամասներ"]"><a href="#specifications">@L["Բնութագրեր"]</a><a href="#compatibility">@L["Համատեղելիություն"]</a>@if (Model.Alternatives.Count > 0) { <a href="#alternatives">@L["Փոխարինող մասեր"]</a> }@if (Model.Related.Count > 0) { <a href="#related">@L["Հարակից ապրանքներ"]</a> }@if (Model.Bundle.Count > 0) { <a href="#bundle">@L["Միասին օգտագործվող մասեր"]</a> }<a href="#delivery">@L["Առաքում և երաշխիք"]</a><a href="/products/@p.Slug/reviews">@L["Կարծիքներ"]</a></nav>
<div class="store-detail-information"><section id="specifications"><h2>@L["Տեխնիկական բնութագրեր"]</h2><div class="spec-list">@if (p.Sku.Length > 0) { <div class="spec-row"><span>@L["Արտիկուլ"]</span><span>@p.Sku</span></div> }@if (p.Manufacturer.Length > 0) { <div class="spec-row"><span>@L["Արտադրող"]</span><span>@p.Manufacturer</span></div> }@if (p.Brand.Length > 0) { <div class="spec-row"><span>@L["Բրենդ"]</span><span>@p.Brand</span></div> }@if (p.Model.Length > 0) { <div class="spec-row"><span>@L["Մոդել"]</span><span>@p.Model</span></div> }@foreach (var spec in p.Specs) { <div class="spec-row"><span>@spec.Key</span><span>@spec.Value</span></div> }@if (p.ReplacementCodes.Count > 0) { <div class="spec-row"><span>@L["Փոխարինման կոդեր"]</span><span>@string.Join(", ", p.ReplacementCodes)</span></div> }</div></section><section id="compatibility"><h2>@L["Համատեղելի սարքեր"]</h2>@if (Model.CompatibleModels.Count > 0) { <div class="store-compatibility-models">@foreach (var group in Model.CompatibleModels.GroupBy(x => x.Brand)) { <div><h3>@group.Key</h3>@foreach (var equipment in group) { <a href="@("/parts?model=" + Uri.EscapeDataString(equipment.Id))">@equipment.Series @equipment.Name <span>→</span></a> }</div> }</div> } else { <p>@L["Համատեղելիությունը ճշտեք սարքի մոդելով, չափերով և ամրացման տեսակով։ Ուղարկեք պիտակի լուսանկարը՝ մասնագետի օգնությամբ ընտրելու համար։"]</p> }<button type="button" class="btn btn-outline" data-request="part" data-subject="@p.Title">@L["Ուղարկել սարքի տվյալները"]</button></section></div>
@if (Model.Alternatives.Count > 0) { <section class="store-section" id="alternatives"><div class="section-heading"><h2>@L["Փոխարինող մասեր"]</h2></div><div class="catalog-grid store-product-grid">@foreach (var item in Model.Alternatives) { <partial name="_ProductCard" model="item" /> }</div></section> }
@if (Model.Related.Count > 0) { <section class="store-section" id="related"><div class="section-heading"><h2>@L["Հարակից ապրանքներ"]</h2></div><div class="catalog-grid store-product-grid">@foreach (var item in Model.Related) { <partial name="_ProductCard" model="item" /> }</div></section> }
@if (Model.Bundle.Count > 0) { <section class="store-section" id="bundle"><div class="section-heading"><h2>@L["Միասին օգտագործվող մասեր"]</h2></div><div class="catalog-grid store-product-grid">@foreach (var item in Model.Bundle) { <partial name="_ProductCard" model="item" /> }</div></section> }
<section class="store-detail-delivery" id="delivery"><div><h2>@L["Առաքում"]</h2><p class="store-multiline">@Model.Settings.Delivery</p><a href="/delivery" class="text-link">@L["Մանրամասն պայմաններ"] →</a></div><div><h2>@L["Երաշխիք"]</h2><p class="store-multiline">@Model.Settings.Warranty</p><a href="/warranty" class="text-link">@L["Մանրամասն պայմաններ"] →</a></div><div><h2>@L["Սպասարկում"]</h2><p>@L["Կարող եք դիմել տեղադրման կամ հետագա սպասարկման համար։ Կատարված աշխատանքի երաշխիքը համաձայնեցվում է առանձին։"]</p><button type="button" class="btn btn-outline" data-request="service" data-subject="@p.Title">@L["Դիմել սպասարկման"]</button></div></section>
</div>
