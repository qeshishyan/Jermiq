@model SitePageModel
@{ var isPart = Model.PageName == "parts"; var products = Model.Products.Where(Model.Matches).OrderByDescending(p => Model.Query.Length > 0 && ProductSearch.Normalize(p.Title).Contains(ProductSearch.Normalize(Model.Query), StringComparison.Ordinal)).ToList(); }
<div class="container pb-16">
<partial name="_Heading" model="@((Model.Title, (string?)Model.Description))" />
@if (isPart)
{
<div class="part-help"><div><h2>@L["Գտնենք ձեր սարքին համապատասխան մասը"]</h2><p>@L["Ուղարկեք սարքի պիտակի կամ պահեստամասի լուսանկարը։ Կճշտենք մոդելը և համապատասխանությունը։"]</p><button type="button" class="btn" data-request="part">@L["Ուղարկել մոդել կամ լուսանկար"]</button></div><img src="/images/parts.webp" alt="@L["Տաքացնող տարր, անոդ, թերմոստատ, միջադիր և փական՝ պատկերային օրինակ"]" width="600" height="400" /></div>
<div class="notice">@L["Պահեստամասերի օրինակներ։ Համատեղելի մոդելների հաստատված ցանկը և գները կլրացվեն։"]</div>
}
else
{ <div class="notice">@(Model.Query.Length > 0 ? L["Որոնումը ներառում է նաև պահեստամասերը։"] : L["Տեսականու պատկերներն ու ապրանքները ցուցադրական օրինակներ են։ Իրական մոդելները, գներն ու առկայությունը կլրացվեն։"])</div> }
<div id="catalog" data-category="@(isPart ? "part" : "heater")">
<div class="filter-bar"><div class="search-box"><input id="catalog-query" maxlength="200" type="search" aria-describedby="search-help" list="catalog-suggestions" value="@Model.Query" placeholder="@(isPart ? L["Որոնել մաս, կոդ կամ մոդել…"] : L["Որոնել ապրանքը…"])" aria-label="@L["Որոնել կատալոգում"]" /><i data-icon="search"></i></div>
@if (!isPart) { <select id="catalog-volume" class="field-select" aria-label="@L["Տարողություն"]"><option value="all">@L["Բոլոր ծավալները"]</option>@foreach (var volume in new[] { 30, 50, 80, 100 }) { <option value="@volume">@volume @L["լ"]</option> }</select> }
@{ var brands = Model.Products.Where(x => !isPart || x.Category == "part").Select(x => x.Brand).Where(x => x.Length > 0).Distinct(); }
@if (brands.Any()) { <select id="catalog-brand" class="field-select" aria-label="@L["Արտադրող"]"><option value="all">@L["Բոլոր արտադրողները"]</option>@foreach (var brand in brands) { <option value="@brand">@brand</option> }</select> }
<select id="catalog-sort" class="field-select" aria-label="@L["Դասավորել"]"><option value="default">@L["Ըստ համապատասխանության"]</option><option value="title">@L["Ըստ անվանման"]</option><option value="price">@L["Գին՝ ցածրից բարձր"]</option></select></div>
<p class="text-sm mb-4" id="search-help">@L["Բանալի բառերը կարող եք գրել ցանկացած հերթականությամբ։ Օրինակ՝ «Ariston 80» կամ «թերմոստատ»։"]</p><datalist id="catalog-suggestions">@foreach (var suggestion in Model.Products.SelectMany(p => new[] { p.Title, p.Model, p.Brand }).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Take(100)) { <option value="@suggestion"></option> }</datalist>
<p class="mb-5 text-sm" id="catalog-count" aria-live="polite">@L["Գտնվել է"] @products.Count @L["ապրանք"]</p>
<div class="catalog-grid" id="catalog-grid">@foreach (var p in products) { <partial name="_ProductCard" model="p" /> }</div>
<div class="empty-state" id="catalog-empty" hidden="@(products.Count > 0)"><i data-icon="package" class="icon-40"></i><h3>@L["Այս տվյալներով ապրանք չի գտնվել"]</h3><p>@L["Փոխեք որոնումը կամ ուղարկեք սարքի տվյալները, որպեսզի օգնենք գտնել համապատասխան տարբերակը։"]</p><div class="actions justify-center"><button type="button" class="btn btn-outline" data-action="catalog-reset">@L["Մաքրել ֆիլտրերը"]</button><button type="button" class="btn" data-request="@(isPart ? "part" : "question")">@L["Օգնեք գտնել"]</button></div></div>
<script type="application/json" id="catalog-data">@Html.Raw(SiteJson.Serialize(Model.Products))</script>
</div>
@if (!isPart) { <div class="service-strip mt-10"><div><h3>@L["Չգիտե՞ք՝ որ տարբերակն ընտրել"]</h3><p>@L["Պատասխանեք երեք կարճ հարցի և ստացեք ընտրության ուղղություն։"]</p></div><button type="button" class="btn" data-action="chooser">@L["Օգնեք ընտրել"]</button></div> }
</div>
