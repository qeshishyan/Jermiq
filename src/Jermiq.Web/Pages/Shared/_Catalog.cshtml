@model SitePageModel
@{ var children = Model.Children(Model.CategoryId).ToList(); if (Model.CategoryId.Length == 0) children = Model.RootCategories.Where(x => Model.PageName != "parts" || x.Id != "water-heaters").ToList(); var facets = Model.CatalogProducts.SelectMany(x => x.Specs).Where(x => x.Key.Length > 0 && x.Value.Length > 0).GroupBy(x => x.Key).Where(x => x.Select(v => v.Value).Distinct().Count() > 1).OrderBy(x => x.Key).Take(8).ToList(); }
<div class="container store-catalog-page" data-store-catalog>
    <nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><a href="/catalog">@L["Կատալոգ"]</a>@if (Model.SelectedCategory is not null) { <span>/</span><span>@Model.SelectedCategory.Title</span> }</nav>
    <div class="store-page-heading"><div><div class="eyebrow">@L["TERMOMASTER · Կատալոգ"]</div><h1>@Model.Title</h1><p>@Model.Description</p></div><a href="/selection" class="btn btn-outline"><i data-icon="search-check"></i>@L["Ընտրել մոդելով"]</a></div>
    @if (children.Count > 0) { <div class="store-category-pills" aria-label="@L["Ենթակատեգորիաներ"]">@foreach (var category in children) { <a href="@Model.CategoryUrl(category)">@category.Title <span aria-hidden="true">›</span></a> }</div> }
    <div class="store-catalog-layout">
        <aside class="store-filter-sidebar"><details class="store-mobile-filters" open><summary><i data-icon="sliders"></i>@L["Կատեգորիաներ և ֆիլտրեր"] <span aria-hidden="true">⌄</span></summary><div class="store-filter-body">
            <nav class="store-category-tree" aria-label="@L["Կատեգորիաներ"]"><a href="/@Model.PageName" class="@(Model.CategoryId.Length == 0 ? "selected" : "")">@L["Բոլոր կատեգորիաները"]</a>@foreach (var root in Model.RootCategories.Where(x => Model.PageName != "parts" || x.Id != "water-heaters")) { <partial name="_CategoryBranch" model="@(new KeyValuePair<StoreCategory, IReadOnlyList<StoreCategory>>(root, Model.Store.Categories))" /> }</nav>
            <form action="/@Model.PageName" method="get" class="store-filter-form"><input type="hidden" name="lang" value="@L.Language" />@if (Model.CategoryId.Length > 0) { <input type="hidden" name="category" value="@Model.CategoryId" /> }<input type="hidden" name="sort" value="@Model.Sort" />
                <label>@L["Որոնում"]<input type="search" name="q" value="@Model.Query" maxlength="200" placeholder="@L["Անվանում, կոդ կամ մոդել"]" /></label>
                <label>@L["Բրենդ"]<select name="brand" class="field-select"><option value="">@L["Բոլոր բրենդները"]</option>@foreach (var brand in Model.CatalogProducts.Select(x => x.Brand).Where(x => x.Length > 0).Distinct().OrderBy(x => x)) { <option value="@brand" selected="@(brand == Model.Brand)">@brand</option> }</select></label>
                <fieldset><legend>@L["Գին, ֏"]</legend><div class="store-price-range"><input type="number" name="min" min="0" step="any" value="@Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="@L["Սկսած"]" aria-label="@L["Նվազագույն գին"]" /><span>—</span><input type="number" name="max" min="0" step="any" value="@Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="@L["Մինչև"]" aria-label="@L["Առավելագույն գին"]" /></div></fieldset>
                @if (Model.ModelId.Length > 0) { <label>@L["Սարքի մոդել"]<select name="model" class="field-select"><option value="">@L["Բոլոր մոդելները"]</option>@foreach (var item in Model.Store.EquipmentModels.Where(x => x.Id == Model.ModelId)) { <option value="@item.Id" selected>@item.Brand @item.Name</option> }</select></label> }
                @foreach (var facet in facets) { <details class="store-facet" open="@(facet.Any(v => Model.SelectedSpecs.Contains(v.Key + ":" + v.Value)))"><summary>@facet.Key <span aria-hidden="true">+</span></summary><div>@foreach (var value in facet.Select(x => x.Value).Distinct().OrderBy(x => x).Take(18)) { var selected = facet.Key + ":" + value; <label class="store-check"><input type="checkbox" name="spec" value="@selected" checked="@Model.SelectedSpecs.Contains(selected)" /><span>@value</span><small>@Model.CatalogProducts.Count(x => x.Specs.TryGetValue(facet.Key, out var v) && v == value)</small></label> }</div></details> }
                <button type="submit" class="btn">@L["Կիրառել ֆիլտրերը"]</button><a href="@(Model.CategoryId.Length > 0 ? "/" + Model.PageName + "?category=" + Uri.EscapeDataString(Model.CategoryId) : "/" + Model.PageName)" class="store-reset">@L["Մաքրել ֆիլտրերը"]</a>
            </form>
        </div></details><div class="store-sidebar-help"><i data-icon="message"></i><h3>@L["Չե՞ք գտնում անհրաժեշտ մասը"]</h3><p>@L["Ուղարկեք սարքի պիտակն ու պահեստամասի լուսանկարը։ Կօգնենք ճշտել համապատասխանությունը։"]</p><button type="button" class="btn btn-outline" data-request="part">@L["Օգնեք գտնել"]</button></div></aside>
        <section class="store-catalog-results" aria-label="@L["Ապրանքներ"]"><div class="store-results-toolbar"><p id="store-result-count"><strong>@Model.ResultCount</strong> @L["ապրանք"]</p><form action="/@Model.PageName" method="get">@foreach (var parameter in Context.Request.Query.Where(x => x.Key != "sort" && x.Key != "pageNumber" && x.Key != "lang")) { foreach (var value in parameter.Value) { <input type="hidden" name="@parameter.Key" value="@value" /> } }<input type="hidden" name="lang" value="@L.Language" /><label for="store-sort">@L["Դասավորել"]</label><select id="store-sort" name="sort" class="field-select" data-store-autosubmit>@foreach (var option in new[] { ("popular", "Առաջարկվող"), ("price", "Գին՝ ցածրից բարձր"), ("price-desc", "Գին՝ բարձրից ցածր"), ("title", "Ըստ անվանման"), ("new", "Նոր տեսականի") }) { <option value="@option.Item1" selected="@(Model.Sort == option.Item1)">@L[option.Item2]</option> }</select><button class="store-sort-submit" type="submit">@L["Կիրառել"]</button></form></div>
            @if (Model.Query.Length > 0 || Model.Brand.Length > 0 || Model.SelectedSpecs.Count > 0 || Model.MinPrice is not null || Model.MaxPrice is not null || Model.ModelId.Length > 0) { <div class="store-active-filters">@if (Model.Query.Length > 0) { <a href="@Model.CatalogUrl("q", null)">@Model.Query <span>×</span></a> }@if (Model.Brand.Length > 0) { <a href="@Model.CatalogUrl("brand", null)">@Model.Brand <span>×</span></a> }@if (Model.ModelId.Length > 0) { <a href="@Model.CatalogUrl("model", null)">@L["Սարքի մոդել"] <span>×</span></a> }@if (Model.SelectedSpecs.Count > 0) { <a href="@Model.CatalogUrl("spec", null)">@L["Տեխնիկական ֆիլտրեր"]: @Model.SelectedSpecs.Count <span>×</span></a> }@if (Model.MinPrice is not null || Model.MaxPrice is not null) { <a href="@Model.CatalogUrl("price-range", null)">@L["Գնի միջակայք"]: @Model.MinPrice – @Model.MaxPrice ֏</a> }</div> }
            @if (Model.Results.Count > 0) { <div class="catalog-grid store-product-grid">@foreach (var product in Model.Results) { <partial name="_ProductCard" model="product" /> }</div> } else { <div class="empty-state store-empty"><i data-icon="package"></i><h2>@L["Այս տվյալներով ապրանք չի գտնվել"]</h2><p>@L["Փոխեք որոնումը կամ ուղարկեք սարքի տվյալները, որպեսզի օգնենք գտնել համապատասխան տարբերակը։"]</p><button type="button" class="btn" data-request="part">@L["Օգնեք գտնել"]</button></div> }
            @if (Model.PageCount > 1) { <nav class="store-pagination" aria-label="@L["Էջավորում"]">@if (Model.PageNumber > 1) { <a href="@Model.CatalogUrl("pageNumber", (Model.PageNumber - 1).ToString())" aria-label="@L["Նախորդ էջ"]">←</a> }@for (var pageIndex = Math.Max(1, Model.PageNumber - 2); pageIndex <= Math.Min(Model.PageCount, Model.PageNumber + 2); pageIndex++) { <a href="@Model.CatalogUrl("pageNumber", pageIndex.ToString())" class="@(pageIndex == Model.PageNumber ? "is-current" : null)" aria-current="@(pageIndex == Model.PageNumber ? "page" : null)">@pageIndex</a> }@if (Model.PageNumber < Model.PageCount) { <a href="@Model.CatalogUrl("pageNumber", (Model.PageNumber + 1).ToString())" aria-label="@L["Հաջորդ էջ"]">→</a> }</nav> }
        </section>
    </div>
</div>
