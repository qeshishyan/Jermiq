@model Product
<article class="product store-product" data-product="@SiteJson.Serialize(Model)">
    <div class="store-product-image"><a href="/products/@Model.Slug" class="product-img"><img src="@Model.Image" alt="@(Model.Demo ? L["Տեսականու պատկերային օրինակ"] : Model.Title)" width="460" height="360" loading="lazy" /></a><div class="store-product-badges">@if (Model.IsNew) { <span class="store-badge-new">@L["Նոր"]</span> }@if (Model.OldPrice > Model.Price && Model.Price is not null) { <span class="store-badge-sale">@L["Զեղչ"]</span> }@if (Model.IsFeatured) { <span>@L["Առաջարկվող"]</span> }</div><button type="button" class="store-favorite" data-action="favorite-toggle" aria-pressed="false" aria-label="@L["Ավելացնել ընտրյալներին"]"><i data-icon="heart"></i></button></div>
    <div class="product-copy"><div class="store-product-meta"><span>@(Model.Brand.Length > 0 ? Model.Brand : Model.Category == "heater" ? L["Ջրատաքացուցիչ"] : L["Պահեստամաս"])</span>@if (Model.Sku.Length > 0) { <small>@L["Կոդ"]: @Model.Sku</small> }</div><a href="/products/@Model.Slug"><h3>@Model.Title</h3></a><div class="store-product-prices"><div class="price">@(Model.Price is null ? L["Հարցնել գինը"] : Model.Price.Value.ToString("N0") + " ֏")</div>@if (Model.OldPrice > Model.Price && Model.Price is not null) { <del>@Model.OldPrice.Value.ToString("N0") ֏</del> }</div>@if (Model.PriceIsEstimate && Model.Price is not null) { <small class="price-estimate">@L["Կողմնորոշիչ գին"]</small> }<div class="stock">@Model.Availability@if (Model.StockQuantity is not null) { <span> · @Model.StockQuantity @L["հատ"]</span> }</div>
        <div class="store-product-actions"><button type="button" class="btn" data-action="add-cart"><i data-icon="bag"></i>@(Model.Price is null ? L["Հարցնել գինը"] : L["Ավելացնել պատվերին"])</button><button type="button" class="compare-button" data-action="compare-toggle" aria-pressed="false" aria-label="@L["Համեմատել"]"><i data-icon="scale"></i></button></div>
    </div>
</article>
