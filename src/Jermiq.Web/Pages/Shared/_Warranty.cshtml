@model SitePageModel
<div class="container pb-16"><partial name="_Heading" model="@((Model.Title, (string?)Model.Description))" /><div class="steps">
<div class="step"><i data-icon="shield" class="icon-32"></i><h3>Ապրանքի երաշխիք</h3><p>Վաճառվող սարքի երաշխիքի ժամկետը, ծածկույթը և պայմանները նշվում են ապրանքի փաստաթղթում։</p></div>
<div class="step"><i data-icon="file-check" class="icon-32"></i><h3>Սպասարկման երաշխիք</h3><p>Նշվում են կատարված աշխատանքը, տեղադրված մասերը, երաշխիքի ժամկետը և կիրառման պայմանները։</p></div>
<div class="step"><i data-icon="stamp" class="icon-32"></i><h3>Մեր կնիքը՝ սարքի վրա</h3><p>Սպասարկումից հետո սարքի վրա դնում ենք մեր կնիքը՝ որպես մեր կողմից սպասարկված սարքի նշում։</p></div></div>
<section class="prose"><h2>Երաշխիքի ժամկետը և ծածկույթը</h2><p>@Model.Settings.Warranty</p><h2>Սարքը գնված է այլ տեղից</h2><p>Կարող եք օգտվել մեր սպասարկումից։ Տրամադրվող երաշխիքը վերաբերում է մեր կատարած աշխատանքին ու փաստաթղթում նշված մասերին։ Սարքի նախկին վաճառողի կամ արտադրողի երաշխիքային պայմանները դրանից առանձին են։</p><h2>Երաշխիքային հարց ունե՞ք</h2><p>Ուղարկեք սարքի մոդելը, աշխատանքի կամ գնման ամսաթիվը և ձեր հարցը։ Եթե ունեք փաստաթուղթ կամ կնիքի լուսանկար, կցեք այն։</p><button type="button" class="btn" data-request="question" data-subject="Երաշխիքային հարց">Դիմել երաշխիքային հարցով</button><p class="mt-6"><a href="/services" class="text-link">Տեսնել սպասարկման ծառայությունները</a></p></section></div>
