@model SitePageModel
<div class="container pb-16"><partial name="_Heading" model="@((Model.Title, (string?)Model.Description))" /><div class="articles-grid">@foreach (var a in Model.Articles) { <article class="article-card"><i data-icon="book" class="icon-32"></i><h2 style="font-size:1.25rem">@a.Title</h2><p>@a.Intro</p><a href="/guide/@a.Slug" class="text-link">@L["Կարդալ նյութը"]</a></article> }</div></div>
