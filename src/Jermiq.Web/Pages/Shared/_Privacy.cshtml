@model SitePageModel
<div class="container pb-16"><partial name="_Heading" model="@((Model.Title, (string?)null))" /><div class="prose">
<h2>@L["Ինչ տվյալներ ենք ստանում"]</h2><p>@L["Հայտի միջոցով դուք տրամադրում եք անուն, հեռախոս, ըստ ցանկության՝ էլ․ փոստ, սարքի տվյալներ, հարցի նկարագրություն և կցված լուսանկար։"]</p>
<h2>@L["Ինչ նպատակով են օգտագործվում"]</h2><p>@L["Տվյալներն օգտագործվում են ձեր հայտի մշակման, ապրանքի կամ պահեստամասի ընտրության, սպասարկման համաձայնեցման և ձեզ հետ կապ հաստատելու համար։ Հայտի համաձայնությունը չի ներառում գովազդային հաղորդագրությունների բաժանորդագրություն։"]</p>
<h2>@L["Ովքեր կարող են տեսնել հայտը"]</h2><p>@L["Հայտերի և կցված ֆայլերի հասանելիությունը սահմանափակվում է լիազորված կառավարմամբ։ Տվյալների մշակման համար օգտագործվում է կայքի պահպանման ենթակառուցվածքը։"]</p>
<h2>@L["Ձեր դիմումները"]</h2><p>@L["Ձեր տվյալների ճշտման կամ հեռացման համար դիմեք կապի ձևով՝ նշելով հայտի համարը։"] @if (Model.Settings.Email.Length > 0) { <text>@L["Կարող եք գրել նաև՝"] @Model.Settings.Email։</text> }</p>
<h2>@L["Կցված ֆայլեր"]</h2><p>@L["Խնդրում ենք ուղարկել միայն սարքին կամ հայտին առնչվող լուսանկարներ։ Մի կցեք անձնագրի, բանկային կամ այլ ավելորդ անձնական տվյալներ։"]</p></div></div>
