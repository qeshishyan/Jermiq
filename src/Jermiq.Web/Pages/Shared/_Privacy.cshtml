@model SitePageModel
<div class="container pb-16"><partial name="_Heading" model="@((Model.Title, (string?)null))" /><div class="prose"><div class="legal-intro">Նախնական տարբերակ։ Մինչև հանրային գործարկումը կլրացվեն ընկերության իրավաբանական տվյալները, տվյալների պահպանման ժամկետներն ու դիմումների կոնտակտները։</div>
<h2>Ինչ տվյալներ ենք ստանում</h2><p>Հայտի միջոցով դուք տրամադրում եք անուն, հեռախոս, ըստ ցանկության՝ էլ․ փոստ, սարքի տվյալներ, հարցի նկարագրություն և կցված լուսանկար։</p>
<h2>Ինչ նպատակով են օգտագործվում</h2><p>Տվյալներն օգտագործվում են ձեր հայտի մշակման, ապրանքի կամ պահեստամասի ընտրության, սպասարկման համաձայնեցման և ձեզ հետ կապ հաստատելու համար։ Հայտի համաձայնությունը չի ներառում գովազդային հաղորդագրությունների բաժանորդագրություն։</p>
<h2>Ովքեր կարող են տեսնել հայտը</h2><p>Հայտերի և կցված ֆայլերի հասանելիությունը սահմանափակվում է լիազորված կառավարմամբ։ Տվյալների մշակման համար օգտագործվում է կայքի պահպանման ենթակառուցվածքը։</p>
<h2>Ձեր դիմումները</h2><p>Ձեր տվյալների ճշտման կամ հեռացման համար դիմեք կապի ձևով՝ նշելով հայտի համարը։ @if (Model.Settings.Email.Length > 0) { <text>Կարող եք գրել նաև՝ @Model.Settings.Email։</text> }</p>
<h2>Ֆայլեր և պահպանման ժամկետ</h2><p>Խնդրում ենք ուղարկել միայն սարքին կամ հայտին առնչվող լուսանկարներ։ Մի կցեք անձնագրի, բանկային կամ այլ ավելորդ անձնական տվյալներ։ Փորձնական հայտերը կարող են հեռացվել կառավարման բաժնից։ Մշտական պահպանման քաղաքականությունը կհաստատվի գործարկումից առաջ։</p></div></div>
