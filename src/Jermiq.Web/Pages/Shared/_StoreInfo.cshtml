@model SitePageModel
@{ var text = Model.PageName == "delivery" ? Model.Settings.Delivery : Model.PageName == "payment" ? Model.Store.PaymentText : Model.Store.AboutText; }
<div class="container store-info-page"><nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><span>@Model.Title</span></nav><div class="store-page-heading"><div><div class="eyebrow">JERMIQ</div><h1>@Model.Title</h1><p>@Model.Description</p></div></div><div class="store-info-layout"><article class="store-info-copy"><div class="store-info-icon"><i data-icon="@(Model.PageName == "delivery" ? "package" : Model.PageName == "payment" ? "file-check" : "wrench")"></i></div><div class="store-multiline">@text</div><div class="actions"><button type="button" class="btn" data-request="question" data-subject="@Model.Title">@L["Ճշտել մանրամասները"]</button><a href="/catalog" class="text-link">@L["Ամբողջ տեսականին"] →</a></div></article><aside class="store-info-nav"><h2>@L["Տեղեկատվություն"]</h2>@foreach (var item in new[] { ("delivery", "Առաքում և ինքնավերցում"), ("payment", "Վճարման պայմաններ"), ("warranty", "Երաշխիք"), ("about", "Ջերմիքի մասին"), ("contact", "Կապ") }) { <a href="/@item.Item1" aria-current="@(Model.PageName == item.Item1 ? "page" : null)">@L[item.Item2] <span aria-hidden="true">→</span></a> }<p>@L["Հարց ունե՞ք։ Օգնենք ընտրության և պատվերի հարցում։"]</p>@if (Model.Settings.Phone.Length > 0) { <a href="tel:@System.Text.RegularExpressions.Regex.Replace(Model.Settings.Phone, "[^+0-9]", "")">@Model.Settings.Phone</a> }<button type="button" class="btn btn-outline" data-request="callback">@L["Պատվիրել հետադարձ զանգ"]</button></aside></div></div>
