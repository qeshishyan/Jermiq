@model SitePageModel
@{ var home = Model.Store.Home; var roots = Model.RootCategories.ToList(); var featured = Model.Products.Where(x => x.IsFeatured).Take(8).ToList(); if (featured.Count == 0) featured = Model.Products.OrderBy(x => x.Category == "part" ? 0 : 1).Take(8).ToList(); var arrivals = Model.Products.Where(x => x.IsNew).Take(4).ToList(); }
<div class="container store-home">
    <div class="store-intro-line"><span><span class="store-status-dot"></span>@L[BrandIdentity.Tagline]</span><a href="/about">@L["TERMOMASTER-ի մասին"] <span aria-hidden="true">↗</span></a></div>
    <div class="store-landing">
        <aside class="store-directory" aria-label="@L["Կատեգորիաներ"]"><div class="store-directory-title"><i data-icon="package"></i>@L["Ապրանքների կատեգորիաներ"]</div><nav>@foreach (var category in roots) { <a href="@Model.CategoryUrl(category)"><span>@category.Title</span><span aria-hidden="true">›</span></a> }</nav><a class="store-directory-all" href="/catalog">@L["Ամբողջ տեսականին"] <span aria-hidden="true">→</span></a></aside>
        <div class="store-hero-area">
            <section class="store-hero marketing-hero" data-marketing-hero><div class="store-hero-copy"><div class="eyebrow">@home.Eyebrow</div><h1>@home.Title</h1><p>@home.Intro</p><div class="actions"><a href="/find-part" class="btn marketing-primary">@L["Գտնենք ճիշտ մասը"] <span aria-hidden="true">→</span></a><a href="/parts" class="btn btn-outline">@L["Դիտել պահեստամասերը"]</a></div><p class="marketing-hero-caption"><i data-icon="search-check"></i>@L["Սկսեք կոդից, մոդելից կամ լուսանկարից։"]</p></div><div class="store-hero-photo"><img src="@home.HeroImage" alt="@L["TERMOMASTER՝ սարքավորումներ և պահեստամասեր"]" width="600" height="480" fetchpriority="high" /><div class="marketing-hero-note"><span class="marketing-note-icon"><i data-icon="package"></i></span><div><strong>@L["Ձեր սարքին համապատասխան"]</strong><span>@L["Ընտրեք մասը, լրացրեք հավաքածուն"]</span></div></div></div></section>
            <div class="store-shortcuts"><a href="/find-part?mode=model"><i data-icon="search-check"></i><div><strong>@L["Գիտեմ սարքի մոդելը"]</strong><span>@L["Տեսնել համապատասխան պահեստամասերը"]</span></div><span aria-hidden="true">↗</span></a><a href="/find-part?mode=photo"><i data-icon="message"></i><div><strong>@L["Ունեմ լուսանկար"]</strong><span>@L["Ուղարկեք պիտակն ու դետալի նկարը"]</span></div><span aria-hidden="true">↗</span></a></div>
            <div class="store-benefits"><a href="/delivery"><i data-icon="package"></i><div><strong>@L["Առաքում և ինքնավերցում"]</strong><span>@L["Ստացման եղանակը՝ համաձայնեցմամբ"]</span></div></a><a href="/warranty"><i data-icon="shield"></i><div><strong>@L["Հստակ երաշխիք"]</strong><span>@L["Ապրանքի և աշխատանքի պայմաններ"]</span></div></a><a href="/services"><i data-icon="wrench"></i><div><strong>@L["Մասնագիտական սպասարկում"]</strong><span>@L["Ընտրությունից մինչև վերանորոգում"]</span></div></a></div>
        </div>
    </div>
    <section class="marketing-finder" aria-labelledby="marketing-finder-title" data-marketing-reveal>
        <div class="marketing-finder-heading"><div><span class="marketing-section-kicker"><span>01</span>@L["Սկսենք ձեր ունեցած տվյալներից"]</span><h2 id="marketing-finder-title">@L["Ճիշտ մասի ընտրությունը սկսվում է այստեղ"]</h2><p>@L["Ընտրեք ձեզ հարմար ճանապարհը։ Կօգնենք անցնել որոնումից դեպի համապատասխան պահեստամաս։"]</p></div><a href="/find-part" class="marketing-inline-link">@L["Բացել ընտրության օգնականը"] <span aria-hidden="true">↗</span></a></div>
        <div class="marketing-paths">
            <a class="marketing-path marketing-path-code" href="/find-part?mode=code"><span class="marketing-path-top"><span class="marketing-path-icon"><i data-icon="search"></i></span><span class="marketing-path-arrow" aria-hidden="true">↗</span></span><strong>@L["Գիտեմ մասի կոդը"]</strong><p>@L["Գրեք արտիկուլը կամ մասի անվանումը և տեսեք որոնման արդյունքները։"]</p><span class="marketing-path-action">@L["Փնտրել կոդով"] <span aria-hidden="true">→</span></span></a>
            <a class="marketing-path marketing-path-model" href="/find-part?mode=model"><span class="marketing-path-top"><span class="marketing-path-icon"><i data-icon="droplets"></i></span><span class="marketing-path-arrow" aria-hidden="true">↗</span></span><strong>@L["Գիտեմ սարքի մոդելը"]</strong><p>@L["Ընտրեք սարքը և դիտեք դրա հետ կապված պահեստամասերը։"]</p><span class="marketing-path-action">@L["Ընտրել մոդելով"] <span aria-hidden="true">→</span></span></a>
            <a class="marketing-path marketing-path-photo" href="/find-part?mode=photo"><span class="marketing-path-top"><span class="marketing-path-icon"><i data-icon="message"></i></span><span class="marketing-path-arrow" aria-hidden="true">↗</span></span><strong>@L["Ունեմ լուսանկար"]</strong><p>@L["Ուղարկեք սարքի պիտակն ու հին դետալի նկարը՝ մասնագետի օգնությամբ ընտրելու համար։"]</p><span class="marketing-path-action">@L["Սկսել լուսանկարից"] <span aria-hidden="true">→</span></span></a>
        </div>
        <form class="marketing-code-search" action="/find-part" method="get"><input type="hidden" name="lang" value="@L.Language" /><input type="hidden" name="mode" value="code" /><label for="marketing-part-query">@L["Կոդն արդեն ձեր ձեռքի՞ն է"]</label><div><input id="marketing-part-query" name="q" type="search" maxlength="200" placeholder="@L["Գրեք արտիկուլը կամ մասի անվանումը"]" required /><button class="btn" type="submit">@L["Գտնել մասը"] <i data-icon="search"></i></button></div></form>
    </section>
    <section class="store-section" id="store-categories"><div class="section-heading"><div><div class="eyebrow">@L["Ընտրեք ձեր սարքը"]</div><h2>@L["Պահեստամասերի կատալոգ"]</h2></div><a href="/catalog" class="text-link">@L["Ամբողջ տեսականին"] →</a></div><div class="store-category-grid">@foreach (var category in roots) { <article class="store-category-card"><div class="store-category-copy"><a href="@Model.CategoryUrl(category)"><h3>@category.Title</h3></a><p>@category.Description</p><div class="store-subcategory-links">@foreach (var child in Model.Children(category.Id).Take(4)) { <a href="@Model.CategoryUrl(child)">@child.Title</a> }</div><a class="text-link" href="@Model.CategoryUrl(category)">@L["Դիտել բաժինը"] <span aria-hidden="true">→</span></a>@if (category.Id == "water-heaters") { <button type="button" class="store-category-chooser" data-action="chooser">@L["Օգնեք ընտրել"] →</button> }</div><img src="@category.Image" alt="" width="180" height="180" loading="lazy" /></article> }</div></section>
    <section class="store-section"><div class="section-heading"><div><div class="eyebrow">@L["Տեսականի"]</div><h2>@home.FeaturedTitle</h2></div><a href="/parts" class="text-link">@L["Բոլոր պահեստամասերը"] →</a></div><div class="catalog-grid store-product-grid">@foreach (var product in featured) { <partial name="_ProductCard" model="product" /> }</div></section>
    <section class="marketing-bundle-story" aria-labelledby="marketing-bundle-title" data-marketing-reveal><div class="marketing-bundle-visual" aria-hidden="true"><span class="marketing-bundle-piece"><i data-icon="package"></i></span><span class="marketing-bundle-plus">+</span><span class="marketing-bundle-piece"><i data-icon="plus"></i></span><span class="marketing-bundle-plus">+</span><span class="marketing-bundle-piece"><i data-icon="check"></i></span></div><div class="marketing-bundle-copy"><span class="marketing-section-kicker"><span>02</span>@L["Մտածված հավաքածու"]</span><h2 id="marketing-bundle-title">@L["Ընտրեք հիմնական մասը։ Լրացրեք անհրաժեշտով։"]</h2><p>@L["Ապրանքի էջում ընտրեք դրա համար առաջարկվող լրացնող մասերը, տեսեք ընտրվածների արժեքը և ավելացրեք միասին։"]</p><a href="/parts" class="marketing-inline-link">@L["Սկսել պահեստամասի ընտրությունից"] <span aria-hidden="true">→</span></a></div></section>
    <section class="store-photo-help" data-marketing-reveal><div class="store-help-icon"><i data-icon="search-check"></i></div><div><div class="eyebrow">@L["Սկսենք ձեր սարքից"]</div><h2>@home.PhotoHelpTitle</h2><p>@home.PhotoHelpText</p></div><a href="/find-part?mode=photo" class="btn">@L["Ուղարկել լուսանկար"] <span aria-hidden="true">↗</span></a></section>
    @if (arrivals.Count > 0) { <section class="store-section"><div class="section-heading"><h2>@L["Նոր տեսականի"]</h2><a href="/catalog?sort=new" class="text-link">@L["Դիտել բոլորը"] →</a></div><div class="catalog-grid store-product-grid">@foreach (var product in arrivals) { <partial name="_ProductCard" model="product" /> }</div></section> }
    <section class="store-wholesale"><div><div class="eyebrow">@L["Համագործակցություն"]</div><h2>@home.WholesaleTitle</h2><p>@home.WholesaleText</p></div><button type="button" class="btn btn-outline" data-request="question" data-subject="@home.WholesaleTitle">@L["Քննարկել համագործակցությունը"] <span aria-hidden="true">→</span></button></section>
    <section class="store-section"><div class="section-heading"><div><div class="eyebrow">@L["Օգտակար է իմանալ"]</div><h2>@L["Օգտակար նյութեր"]</h2></div><a href="/guide" class="text-link">@L["Բոլոր նյութերը"] →</a></div><div class="articles-grid">@foreach (var article in Model.Articles.Take(3)) { <article class="article-card"><i data-icon="book"></i><h3>@article.Title</h3><p>@article.Intro</p><a href="/guide/@article.Slug" class="text-link">@L["Կարդալ նյութը"] →</a></article> }</div></section>
</div>
