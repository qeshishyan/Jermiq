@model SitePageModel
<div class="container">
<section class="hero"><div class="hero-copy"><div class="eyebrow">@L["Ձեր տան տաք ջրի համար"]</div><h1>@L["Տաք ջուր։"]<br /><span>@L["Վստահելի"]<br />@L["սպասարկում։"]</span></h1><p>@L["Ջրատաքացուցիչներ, ճիշտ պահեստամասեր և մասնագիտական սպասարկում՝ մեկ տեղում։"]</p><div class="actions"><a href="/catalog" class="btn">@L["Ընտրել ջրատաքացուցիչ"]</a><button type="button" class="btn btn-outline" data-request="service">@L["Պատվիրել սպասարկում"]</button></div></div><div class="hero-photo"><img src="/images/hero.webp" alt="@L["Էլեկտրական ջրատաքացուցիչ՝ լուսավոր լոգարանում, պատկերային օրինակ"]" width="768" height="512" fetchpriority="high" /><div class="hero-stamp"><i data-icon="shield" class="icon-32"></i><div><strong>@L["Երաշխիք նաև սպասարկման համար"]</strong><small>@L["Կատարված աշխատանք, փաստաթուղթ և մեր կնիքը"]</small></div></div></div></section>
<div class="benefits"><div class="benefit"><i data-icon="search-check"></i><div>@L["Օգնություն ճիշտ ընտրության հարցում"]<small>@L["Սարքից մինչև համապատասխան պահեստամաս"]</small></div></div><div class="benefit"><i data-icon="wrench"></i><div>@L["Սպասարկում նաև այլ տեղից գնված սարքերին"]<small>@L["Դիմեք՝ անկախ գնման վայրից"]</small></div></div><div class="benefit"><i data-icon="shield"></i><div>@L["Հստակ երաշխիքային պայմաններ"]<small>@L["Նշվում են կատարված աշխատանքն ու ժամկետը"]</small></div></div></div>
</div>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">@L["Ինչո՞վ կարող ենք օգնել"]</div><h2>@L["Ձեր խնդրի լուծումը՝ այստեղ"]</h2></div></div><div class="category-grid">
<article class="category"><h3>@L["Ջրատաքացուցիչներ"]</h3><p>@L["Գտեք ձեր տան կարիքներին և տարածքին համապատասխան տարբերակը։"]</p><img src="/images/hero.webp" alt="@L["Ջրատաքացուցիչի պատկերային օրինակ"]" loading="lazy" width="400" height="260" /><a href="/catalog" class="btn btn-outline">@L["Տեսնել տեսականին"]</a></article>
<article class="category"><h3>@L["Պահեստամասեր"]</h3><p>@L["ՏԷՆ-եր, անոդներ, թերմոստատներ, միջադիրներ և այլ մասեր։"]</p><img src="/images/parts.webp" alt="@L["Ջրատաքացուցիչի պահեստամասեր, պատկերային օրինակ"]" loading="lazy" width="400" height="260" /><a href="/parts" class="btn btn-outline">@L["Գտնել պահեստամասը"]</a></article>
<article class="category"><h3>@L["Սպասարկում"]</h3><p>@L["Ախտորոշում, մաքրում, վերանորոգում և տեղադրում։"]</p><div class="service-icon"><i data-icon="wrench" class="icon-75"></i></div><button type="button" class="btn btn-outline" data-request="service">@L["Դիմել մասնագետին"]</button></article>
</div></div></section>
<section class="container"><div class="chooser-banner"><div><div class="eyebrow" style="color:#ffa66f">@L["Դեռ չե՞ք կողմնորոշվել"]</div><h2>@L["Օգնենք ընտրել"]</h2><p>@L["Պատասխանեք երեք պարզ հարցի։ Կհասկանանք ձեր կարիքները և կօգնենք ընտրել համապատասխան սարքը։"]</p></div><div class="choice-preview"><button type="button" data-action="chooser"><i data-icon="users"></i>@L["Ընտանիքի չափ"]</button><button type="button" data-action="chooser"><i data-icon="home"></i>@L["Տեղադրման վայր"]</button><button type="button" data-action="chooser"><i data-icon="droplets"></i>@L["Ջրի օգտագործում"]</button></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">@L["Տեսականի"]</div><h2>@L["Ջրատաքացուցիչներ ձեր տան համար"]</h2><p>@L["Գտեք ձեր տան պահանջներին համապատասխան ջրատաքացուցիչը։"]</p></div><a href="/catalog" class="text-link">@L["Ամբողջ տեսականին"]</a></div><div class="catalog-grid">@foreach (var p in Model.Products.Where(x => x.Category == "heater").OrderByDescending(x => x.SourceUrl.Length > 0).Take(4)) { <partial name="_ProductCard" model="p" /> }</div></div></section>
<section class="container"><div class="service-strip"><i data-icon="wrench" class="icon-40"></i><div><h2>@L["Ձեր սարքը մեզանի՞ց չէ"]</h2><p>@L["Դա չի խանգարում դիմել մեզ։ Սպասարկում ենք նաև այլ տեղից գնված ջրատաքացուցիչները և երաշխիք ենք տալիս մեր կատարած աշխատանքի համար։"]</p></div><button type="button" class="btn" data-request="service">@L["Դիմել սպասարկման"]</button></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">@L["Պարզ և հասկանալի"]</div><h2>@L["Հարցից մինչև լուծում"]</h2></div></div><div class="steps">
<div class="step"><div class="number">01</div><h3>@L["Գրեք կամ ընտրեք"]</h3><p>@L["Ընտրեք ապրանքը, նկարագրեք խնդիրը կամ ուղարկեք սարքի լուսանկարը։"]</p></div>
<div class="step"><div class="number">02</div><h3>@L["Համաձայնեցնենք մանրամասները"]</h3><p>@L["Ճշտում ենք համապատասխանությունը, գինը և աշխատանքի ծավալը։"]</p></div>
<div class="step"><div class="number">03</div><h3>@L["Ստացեք ապրանքը կամ սպասարկումը"]</h3><p>@L["Երաշխիքի պայմանները տրամադրվում են կոնկրետ ապրանքի կամ կատարված աշխատանքի համար։"]</p></div>
</div></div></section>
<section class="section" style="background:#edf3f3"><div class="container"><div class="section-heading"><div><div class="eyebrow">@L["Օգտակար նյութեր"]</div><h2>@L["Ընտրեք տեղեկացված"]</h2></div><a href="/guide" class="text-link">@L["Բոլոր նյութերը"]</a></div><div class="articles-grid">@foreach (var article in Model.Articles) { <article class="article-card"><i data-icon="book"></i><h3>@article.Title</h3><p>@article.Intro</p><a href="/guide/@article.Slug" class="text-link">@L["Կարդալ նյութը"]</a></article> }</div></div></section>
<section class="section"><div class="container"><div class="chooser-banner"><div><h2>@L["Հարց ունե՞ք։ Գրեք մեզ։"]</h2><p>@L["Եթե չգիտեք՝ ինչ սարք կամ պահեստամաս է պետք, սկսեք հարցից։"]</p></div><div class="actions"><button type="button" class="btn" data-request="question">@L["Գրել հարցը"]</button><button type="button" class="btn callback-button" data-request="callback"><span class="callback-icon"><i data-icon="phone"></i></span><span>@L["Պատվիրել հետադարձ զանգ"]</span><span class="callback-arrow" aria-hidden="true">↗</span></button></div></div></div></section>
