@model SitePageModel
<div class="container">
<section class="hero"><div class="hero-copy"><div class="eyebrow">Ձեր տան տաք ջրի համար</div><h1>Տաք ջուր։<br /><span>Վստահելի<br />սպասարկում։</span></h1><p>Ջրատաքացուցիչներ, ճիշտ պահեստամասեր և մասնագիտական սպասարկում՝ մեկ տեղում։</p><div class="actions"><a href="/catalog" class="btn">Ընտրել ջրատաքացուցիչ</a><button type="button" class="btn btn-outline" data-request="service">Պատվիրել սպասարկում</button></div></div><div class="hero-photo"><img src="/images/hero.webp" alt="Էլեկտրական ջրատաքացուցիչ՝ լուսավոր լոգարանում, պատկերային օրինակ" width="768" height="512" fetchpriority="high" /><div class="hero-stamp"><i data-icon="shield" class="icon-32"></i><div><strong>Երաշխիք նաև սպասարկման համար</strong><small>Կատարված աշխատանք, փաստաթուղթ և մեր կնիքը</small></div></div></div></section>
<div class="benefits"><div class="benefit"><i data-icon="search-check"></i><div>Օգնություն ճիշտ ընտրության հարցում<small>Սարքից մինչև համապատասխան պահեստամաս</small></div></div><div class="benefit"><i data-icon="wrench"></i><div>Սպասարկում նաև այլ տեղից գնված սարքերին<small>Դիմեք՝ անկախ գնման վայրից</small></div></div><div class="benefit"><i data-icon="shield"></i><div>Հստակ երաշխիքային պայմաններ<small>Նշվում են կատարված աշխատանքն ու ժամկետը</small></div></div></div>
</div>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">Ինչո՞վ կարող ենք օգնել</div><h2>Ձեր խնդրի լուծումը՝ այստեղ</h2></div></div><div class="category-grid">
<article class="category"><h3>Ջրատաքացուցիչներ</h3><p>Գտեք ձեր տան կարիքներին և տարածքին համապատասխան տարբերակը։</p><img src="/images/hero.webp" alt="Ջրատաքացուցիչի պատկերային օրինակ" loading="lazy" width="400" height="260" /><a href="/catalog" class="btn btn-outline">Տեսնել տեսականին</a></article>
<article class="category"><h3>Պահեստամասեր</h3><p>ՏԷՆ-եր, անոդներ, թերմոստատներ, միջադիրներ և այլ մասեր։</p><img src="/images/parts.webp" alt="Ջրատաքացուցիչի պահեստամասեր, պատկերային օրինակ" loading="lazy" width="400" height="260" /><a href="/parts" class="btn btn-outline">Գտնել պահեստամասը</a></article>
<article class="category"><h3>Սպասարկում</h3><p>Ախտորոշում, մաքրում, վերանորոգում և տեղադրում։</p><div class="service-icon"><i data-icon="wrench" class="icon-75"></i></div><button type="button" class="btn btn-outline" data-request="service">Դիմել մասնագետին</button></article>
</div></div></section>
<section class="container"><div class="chooser-banner"><div><div class="eyebrow" style="color:#ffa66f">Դեռ չե՞ք կողմնորոշվել</div><h2>Օգնենք ընտրել</h2><p>Պատասխանեք երեք պարզ հարցի։ Կհասկանանք ձեր կարիքները և կօգնենք ընտրել համապատասխան սարքը։</p></div><div class="choice-preview"><button type="button" data-action="chooser"><i data-icon="users"></i>Ընտանիքի չափ</button><button type="button" data-action="chooser"><i data-icon="home"></i>Տեղադրման վայր</button><button type="button" data-action="chooser"><i data-icon="droplets"></i>Ջրի օգտագործում</button></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">Տեսականի</div><h2>Ջրատաքացուցիչներ ձեր տան համար</h2><p>Նախնական օրինակներ․ հաստատված արտադրողներն ու մոդելները կլրացվեն։</p></div><a href="/catalog" class="text-link">Ամբողջ տեսականին</a></div><div class="catalog-grid">@foreach (var p in Model.Products.Where(x => x.Category == "heater").Take(4)) { <partial name="_ProductCard" model="p" /> }</div></div></section>
<section class="container"><div class="service-strip"><i data-icon="wrench" class="icon-40"></i><div><h2>Ձեր սարքը մեզանի՞ց չէ</h2><p>Դա չի խանգարում դիմել մեզ։ Սպասարկում ենք նաև այլ տեղից գնված ջրատաքացուցիչները և երաշխիք ենք տալիս մեր կատարած աշխատանքի համար։</p></div><button type="button" class="btn" data-request="service">Դիմել սպասարկման</button></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><div class="eyebrow">Պարզ և հասկանալի</div><h2>Հարցից մինչև լուծում</h2></div></div><div class="steps">
<div class="step"><div class="number">01</div><h3>Գրեք կամ ընտրեք</h3><p>Ընտրեք ապրանքը, նկարագրեք խնդիրը կամ ուղարկեք սարքի լուսանկարը։</p></div>
<div class="step"><div class="number">02</div><h3>Համաձայնեցնենք մանրամասները</h3><p>Ճշտում ենք համապատասխանությունը, գինը և աշխատանքի ծավալը։</p></div>
<div class="step"><div class="number">03</div><h3>Ստացեք ապրանքը կամ սպասարկումը</h3><p>Երաշխիքի պայմանները տրամադրվում են կոնկրետ ապրանքի կամ կատարված աշխատանքի համար։</p></div>
</div></div></section>
<section class="section" style="background:#edf3f3"><div class="container"><div class="section-heading"><div><div class="eyebrow">Օգտակար նյութեր</div><h2>Ընտրեք տեղեկացված</h2></div><a href="/guide" class="text-link">Բոլոր նյութերը</a></div><div class="articles-grid">@foreach (var article in Model.Articles) { <article class="article-card"><i data-icon="book"></i><h3>@article.Title</h3><p>@article.Intro</p><a href="/guide/@article.Slug" class="text-link">Կարդալ նյութը</a></article> }</div></div></section>
<section class="section"><div class="container"><div class="chooser-banner"><div><h2>Հարց ունե՞ք։ Գրեք մեզ։</h2><p>Եթե չգիտեք՝ ինչ սարք կամ պահեստամաս է պետք, սկսեք հարցից։</p></div><div class="actions"><button type="button" class="btn" data-request="question">Գրել հարցը</button><button type="button" class="btn btn-outline" data-request="callback">Զանգահարեք ինձ</button></div></div></div></section>
