@model SitePageModel
@{ var home = Model.Store.Home; var roots = Model.RootCategories.ToList(); var featured = Model.Products.Where(x => x.IsFeatured).Take(8).ToList(); if (featured.Count == 0) featured = Model.Products.OrderBy(x => x.Category == "part" ? 0 : 1).Take(8).ToList(); var arrivals = Model.Products.Where(x => x.IsNew).Take(4).ToList(); }
<div class="container store-home">
    <div class="store-intro-line"><span><span class="store-status-dot"></span>@L["Պահեստամասեր և մասնագիտական սպասարկում"]</span><a href="/about">@L["Ջերմիքի մասին"] <span aria-hidden="true">↗</span></a></div>
    <div class="store-landing">
        <aside class="store-directory" aria-label="@L["Կատեգորիաներ"]"><div class="store-directory-title"><i data-icon="package"></i>@L["Ապրանքների կատեգորիաներ"]</div><nav>@foreach (var category in roots) { <a href="@Model.CategoryUrl(category)"><span>@category.Title</span><span aria-hidden="true">›</span></a> }</nav><a class="store-directory-all" href="/catalog">@L["Ամբողջ տեսականին"] <span aria-hidden="true">→</span></a></aside>
        <div class="store-hero-area">
            <section class="store-hero"><div class="store-hero-copy"><div class="eyebrow">@home.Eyebrow</div><h1>@home.Title</h1><p>@home.Intro</p><div class="actions"><a href="/parts" class="btn">@L["Գտնել պահեստամասը"] <span aria-hidden="true">→</span></a><a href="/selection" class="btn btn-outline">@L["Ընտրել մոդելով"]</a></div></div><div class="store-hero-photo"><img src="@home.HeroImage" alt="@L["Ջերմիք՝ սարքավորումներ և պահեստամասեր"]" width="600" height="480" fetchpriority="high" /><span class="store-hero-mark">JERMIQ<span>@L["Ճիշտ մասը՝ ձեր սարքի համար"]</span></span></div></section>
            <div class="store-shortcuts"><a href="/selection"><i data-icon="search-check"></i><div><strong>@L["Ընտրություն ըստ մոդելի"]</strong><span>@L["Գտեք համապատասխան պահեստամասերը"]</span></div><span aria-hidden="true">↗</span></a><button type="button" data-request="part"><i data-icon="message"></i><div><strong>@L["Օգնություն լուսանկարով"]</strong><span>@L["Ուղարկեք պիտակն ու դետալի նկարը"]</span></div><span aria-hidden="true">↗</span></button></div>
            <div class="store-benefits"><a href="/delivery"><i data-icon="package"></i><div><strong>@L["Առաքում և ինքնավերցում"]</strong><span>@L["Ստացման եղանակը՝ համաձայնեցմամբ"]</span></div></a><a href="/warranty"><i data-icon="shield"></i><div><strong>@L["Հստակ երաշխիք"]</strong><span>@L["Ապրանքի և աշխատանքի պայմաններ"]</span></div></a><a href="/services"><i data-icon="wrench"></i><div><strong>@L["Մասնագիտական սպասարկում"]</strong><span>@L["Ընտրությունից մինչև վերանորոգում"]</span></div></a></div>
        </div>
    </div>
    <section class="store-section" id="store-categories"><div class="section-heading"><div><div class="eyebrow">@L["Ընտրեք ձեր սարքը"]</div><h2>@L["Պահեստամասերի կատալոգ"]</h2></div><a href="/catalog" class="text-link">@L["Ամբողջ տեսականին"] →</a></div><div class="store-category-grid">@foreach (var category in roots) { <article class="store-category-card"><div class="store-category-copy"><a href="@Model.CategoryUrl(category)"><h3>@category.Title</h3></a><p>@category.Description</p><div class="store-subcategory-links">@foreach (var child in Model.Children(category.Id).Take(4)) { <a href="@Model.CategoryUrl(child)">@child.Title</a> }</div><a class="text-link" href="@Model.CategoryUrl(category)">@L["Դիտել բաժինը"] <span aria-hidden="true">→</span></a>@if (category.Id == "water-heaters") { <button type="button" class="store-category-chooser" data-action="chooser">@L["Օգնեք ընտրել"] →</button> }</div><img src="@category.Image" alt="" width="180" height="180" loading="lazy" /></article> }</div></section>
    <section class="store-section"><div class="section-heading"><div><div class="eyebrow">@L["Տեսականի"]</div><h2>@home.FeaturedTitle</h2></div><a href="/parts" class="text-link">@L["Բոլոր պահեստամասերը"] →</a></div><div class="catalog-grid store-product-grid">@foreach (var product in featured) { <partial name="_ProductCard" model="product" /> }</div></section>
    <section class="store-photo-help"><div class="store-help-icon"><i data-icon="search-check"></i></div><div><div class="eyebrow">@L["Սկսենք ձեր սարքից"]</div><h2>@home.PhotoHelpTitle</h2><p>@home.PhotoHelpText</p></div><button type="button" class="btn" data-request="part">@L["Ուղարկել լուսանկար"] <span aria-hidden="true">↗</span></button></section>
    @if (arrivals.Count > 0) { <section class="store-section"><div class="section-heading"><h2>@L["Նոր տեսականի"]</h2><a href="/catalog?sort=new" class="text-link">@L["Դիտել բոլորը"] →</a></div><div class="catalog-grid store-product-grid">@foreach (var product in arrivals) { <partial name="_ProductCard" model="product" /> }</div></section> }
    <section class="store-wholesale"><div><div class="eyebrow">@L["Համագործակցություն"]</div><h2>@home.WholesaleTitle</h2><p>@home.WholesaleText</p></div><button type="button" class="btn btn-outline" data-request="question" data-subject="@home.WholesaleTitle">@L["Քննարկել համագործակցությունը"] <span aria-hidden="true">→</span></button></section>
    <section class="store-section"><div class="section-heading"><div><div class="eyebrow">@L["Օգտակար է իմանալ"]</div><h2>@L["Օգտակար նյութեր"]</h2></div><a href="/guide" class="text-link">@L["Բոլոր նյութերը"] →</a></div><div class="articles-grid">@foreach (var article in Model.Articles.Take(3)) { <article class="article-card"><i data-icon="book"></i><h3>@article.Title</h3><p>@article.Intro</p><a href="/guide/@article.Slug" class="text-link">@L["Կարդալ նյութը"] →</a></article> }</div></section>
</div>
