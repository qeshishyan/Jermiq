@model RequestSpec
<form class="request-form" data-request-spec="@SiteJson.Serialize(Model)" action="/api/leads" method="post" enctype="multipart/form-data">
<input type="hidden" name="kind" value="@Model.Kind" /><input type="hidden" name="subject" value="@Model.Subject" /><input type="hidden" name="details" value="@Model.Details" /><input type="hidden" name="requestId" value="@Guid.NewGuid()" />
<div class="form-grid"><label class="field">@L["Անուն *"]<input name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="@L["Ինչպե՞ս դիմենք ձեզ"]" /></label><label class="field">@L["Հեռախոս *"]<input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="+374 …" pattern="[+0-9 \(\)\-]{7,30}" /></label>
<label class="field full" data-for="service" hidden="@(Model.Kind != "service")">@L["Ինչպիսի՞ խնդիր կա"]<select name="issue"><option value="">@L["Ընտրեք խնդիրը"]</option>@foreach (var issue in new[] { L["Չի տաքացնում ջուրը"], L["Արտահոսք կա"], L["Չի միանում"], L["Անջատում է ավտոմատը"], L["Մաքրում և սպասարկում"], L["Տեղադրում"], L["Ախտորոշում"], L["Վերանորոգում"], L["Այլ խնդիր"] }) { <option value="@issue">@issue</option> }</select></label>
<label class="field" data-for="service part" hidden="@(Model.Kind is not ("service" or "part"))">@L["Սարքի արտադրողը"]<input name="brand" maxlength="100" placeholder="@L["Եթե գիտեք"]" /></label><label class="field" data-for="service part" hidden="@(Model.Kind is not ("service" or "part"))">@L["Մոդել կամ մասի կոդ"]<input name="model" maxlength="100" placeholder="@L["Պիտակի վրա նշված մոդելը"]" /></label>
<div class="notice field full request-subject" hidden="@(string.IsNullOrEmpty(Model.Subject))">@Model.Subject</div><label class="field full">@L["Էլ․ փոստ"]<input name="email" type="email" autocomplete="email" maxlength="200" placeholder="@L["Ըստ ցանկության"]" /></label><label class="field full"><span class="message-label">@L["Հարցը կամ լրացուցիչ մանրամասները"]</span><textarea name="message" maxlength="3000" placeholder="@L["Գրեք, թե ինչով կարող ենք օգնել։"]"></textarea></label>
<div class="field full photo-guide" data-for="service part question" hidden="@(Model.Kind is not ("service" or "part" or "question"))"><strong>@L["Սարքի երկու լուսանկար"]</strong><p>@L["1. Ընդհանուր տեսք․ լուսանկարեք ջրատաքացուցիչը 3–5 մետր հեռավորությունից, որպեսզի երևան ամբողջ սարքն ու միացումները։"]</p><label class="field">@L["Առաջին նկար՝ ընդհանուր տեսք"]<input name="attachment" type="file" accept="image/jpeg,image/png,image/webp" /></label><p>@L["2. Պիտակի մոտիկ լուսանկար․ սարքի մոդելն ու տեխնիկական տվյալները պետք է լինեն հստակ ընթեռնելի։"]</p><label class="field">@L["Երկրորդ նկար՝ տեխնիկական պիտակ"]<input name="attachment2" type="file" accept="image/jpeg,image/png,image/webp" /></label><small>@L["Լուսանկարներն ըստ ցանկության են։ Յուրաքանչյուր ֆայլ՝ JPEG, PNG կամ WebP, մինչև 5 ՄԲ։"]</small></div>
<div class="hidden-field" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div></div>
<label class="checkbox-line"><input name="consent" type="checkbox" value="true" required /><span>@L["Համաձայն եմ, որ իմ տվյալներն օգտագործվեն այս հայտի մշակման և ինձ հետ կապ հաստատելու համար։"] <a href="/privacy" class="text-link">@L["Գաղտնիության պայմաններ"]</a></span></label>
<p class="error-text" role="alert" hidden></p><button class="btn w-full" type="submit">@L["Ուղարկել հայտը"]</button><p class="form-note">@L["Հայտը չի նշանակում հաստատված գնում կամ այց․ մանրամասները համաձայնեցվում են կապ հաստատելուց հետո։"]</p></form>
