@model RequestSpec
<form class="request-form" data-request-spec="@SiteJson.Serialize(Model)" action="/api/leads" method="post" enctype="multipart/form-data">
<input type="hidden" name="kind" value="@Model.Kind" /><input type="hidden" name="subject" value="@Model.Subject" /><input type="hidden" name="details" value="@Model.Details" /><input type="hidden" name="requestId" value="@Guid.NewGuid()" />
<div class="form-grid"><label class="field">Անուն *<input name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Ինչպե՞ս դիմենք ձեզ" /></label><label class="field">Հեռախոս *<input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="+374 …" pattern="[+0-9 \(\)\-]{7,30}" /></label>
<label class="field full" data-for="service" hidden="@(Model.Kind != "service")">Ինչպիսի՞ խնդիր կա<select name="issue"><option value="">Ընտրեք խնդիրը</option>@foreach (var issue in new[] { "Չի տաքացնում ջուրը", "Արտահոսք կա", "Չի միանում", "Անջատում է ավտոմատը", "Մաքրում և սպասարկում", "Տեղադրում", "Ախտորոշում", "Վերանորոգում", "Այլ խնդիր" }) { <option value="@issue">@issue</option> }</select></label>
<label class="field" data-for="service part" hidden="@(Model.Kind is not ("service" or "part"))">Սարքի արտադրողը<input name="brand" maxlength="100" placeholder="Եթե գիտեք" /></label><label class="field" data-for="service part" hidden="@(Model.Kind is not ("service" or "part"))">Մոդել կամ մասի կոդ<input name="model" maxlength="100" placeholder="Պիտակի վրա նշված մոդելը" /></label>
<div class="notice field full request-subject" hidden="@(string.IsNullOrEmpty(Model.Subject))">@Model.Subject</div><label class="field full">Էլ․ փոստ<input name="email" type="email" autocomplete="email" maxlength="200" placeholder="Ըստ ցանկության" /></label><label class="field full"><span class="message-label">Հարցը կամ լրացուցիչ մանրամասները</span><textarea name="message" maxlength="3000" placeholder="Գրեք, թե ինչով կարող ենք օգնել։"></textarea></label>
<label class="field full" data-for="service part question" hidden="@(Model.Kind is not ("service" or "part" or "question"))">Կցել լուսանկար<input name="attachment" type="file" accept="image/jpeg,image/png,image/webp" /><small>JPEG, PNG կամ WebP, առավելագույնը՝ 5 ՄԲ։</small></label>
<div class="hidden-field" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div></div>
<label class="checkbox-line"><input name="consent" type="checkbox" value="true" required /><span>Համաձայն եմ, որ իմ տվյալներն օգտագործվեն այս հայտի մշակման և ինձ հետ կապ հաստատելու համար։ <a href="/privacy" class="text-link">Գաղտնիության պայմաններ</a></span></label>
<p class="error-text" role="alert" hidden></p><button class="btn w-full" type="submit">Ուղարկել հայտը</button><p class="form-note">Հայտը չի նշանակում հաստատված գնում կամ այց․ մանրամասները համաձայնեցվում են կապ հաստատելուց հետո։</p></form>
