@model SitePageModel
@{ var models = Model.SelectionModels.Where(x => Model.Brand.Length == 0 || x.Brand.Equals(Model.Brand, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Brand).ThenBy(x => x.Series).ThenBy(x => x.Name).ToList(); }
<div class="container store-selection-page"><nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><span>@Model.Title</span></nav><div class="store-page-heading"><div><div class="eyebrow">@L["Ճիշտ մասը՝ ձեր սարքի համար"]</div><h1>@Model.Title</h1><p>@Model.Description</p></div></div>
    <form class="store-selection-form" action="/selection" method="get"><input type="hidden" name="lang" value="@L.Language" /><label><span class="store-step">01</span>@L["Սարքի տեսակ"]<select name="category" class="field-select"><option value="">@L["Բոլոր սարքերը"]</option>@foreach (var category in Model.RootCategories.Where(x => x.Id != "water-heaters")) { <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Title</option> }</select></label><label><span class="store-step">02</span>@L["Սարքի բրենդ"]<select name="brand" class="field-select"><option value="">@L["Բոլոր բրենդները"]</option>@foreach (var brand in Model.SelectionModels.Select(x => x.Brand).Distinct().OrderBy(x => x)) { <option value="@brand" selected="@(Model.Brand == brand)">@brand</option> }</select></label><button class="btn" type="submit">@L["Ցույց տալ մոդելները"] <span aria-hidden="true">→</span></button></form>
    @if (models.Count > 0) { <section class="store-section"><div class="section-heading"><div><div class="eyebrow">03 · @L["Ընտրեք ձեր մոդելը"]</div><h2>@L["Համապատասխան պահեստամասեր"]</h2></div><span>@models.Count @L["մոդել"]</span></div><div class="store-model-groups">@foreach (var group in models.GroupBy(x => new { x.Brand, x.Series })) { <section class="store-model-group"><h3>@group.Key.Brand @group.Key.Series</h3><div>@foreach (var equipment in group) { <a href="@("/parts?model=" + Uri.EscapeDataString(equipment.Id) + "&category=" + Uri.EscapeDataString(equipment.CategoryId))"><span>@equipment.Name</span><span aria-hidden="true">→</span></a> }</div></section> }</div></section> }
    else { <section class="store-selection-help"><div class="store-help-icon"><i data-icon="search-check"></i></div><div><h2>@L["Գտնենք ձեր սարքի պահեստամասը"]</h2><p>@L["Եթե ձեր մոդելը ցանկում չկա, ուղարկեք տեխնիկական պիտակի և հին դետալի լուսանկարները։ Կճշտենք համապատասխանությունը և կօգնենք ընտրել։"]</p><div class="actions"><button type="button" class="btn" data-request="part" data-subject="@Model.SelectedCategory?.Title">@L["Ուղարկել մոդել կամ լուսանկար"]</button><a href="/parts" class="btn btn-outline">@L["Փնտրել կատալոգում"]</a></div></div></section> }
    <div class="store-selection-note"><i data-icon="shield"></i><p>@L["Համեմատեք նաև դետալի չափերը, ամրացումն ու տեխնիկական տվյալները։ Անորոշության դեպքում ճշտեք համապատասխանությունը մասնագետի հետ։"]</p></div>
</div>
