@model SitePageModel
<div class="container pb-16"><partial name="_Heading" model="@((Model.Title, (string?)Model.Description))" />
<div class="service-strip mb-9"><i data-icon="shield" class="icon-40"></i><div><h3>@L["Երաշխիք՝ մեր կատարած աշխատանքի համար"]</h3><p>@L["Սպասարկումից հետո տրամադրվում է երաշխիքային փաստաթուղթ և սարքի վրա դրվում է մեր կնիքը։"]</p></div><button type="button" class="btn" data-request="service">@L["Պատվիրել սպասարկում"]</button></div>
<div class="service-grid">@for (var i = 0; i < Model.Services.Count; i++) { var s = Model.Services[i]; <article class="service-card"><div class="service-number">@((i + 1).ToString("D2"))</div><h2>@s.Title</h2><p>@s.Desc</p><div class="price">@(Model.Settings.ServicePrices.GetValueOrDefault(s.Id) ?? L["Գինը՝ աշխատանքի ծավալը ճշտելուց հետո"])</div><button type="button" class="btn btn-outline" data-request="service" data-subject="@s.Title">@L["Դիմել այս ծառայության համար"]</button></article> }</div>
<section class="section prose"><h2>@L["Ինչպե՞ս է որոշվում արժեքը"]</h2><p>@L["Արժեքը կախված է սարքի մոդելից, խնդրից, աշխատանքի ծավալից և անհրաժեշտ պահեստամասերից։ Աշխատանքի, մասերի և լրացուցիչ ծառայությունների արժեքները համաձայնեցվում են մինչև աշխատանքը սկսելը։"]</p><h2>@L["Ինչպե՞ս դիմել"]</h2><p>@L["Նշեք խնդիրը, արտադրողն ու մոդելը, եթե գիտեք։ Կարող եք կցել լուսանկար և գրել հասցեն կամ տարածքը։ Հայտից հետո համաձայնեցնում ենք հաջորդ քայլը։"]</p><button type="button" class="btn" data-request="service"><i data-icon="wrench"></i>@L["Նկարագրել խնդիրը"]</button></section></div>
