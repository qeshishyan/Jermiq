@page "/find-part"
@model FindPartModel
<link rel="stylesheet" href="/css/part-finder.css" asp-append-version="true" />
<div class="container part-finder" data-part-finder data-finder-active="@Model.Mode">
    <nav class="breadcrumbs" aria-label="@L["Էջի ուղին"]"><a href="/">@L["Գլխավոր"]</a><span>/</span><span>@L["Գտնենք ճիշտ մասը"]</span></nav>
    <header class="finder-heading"><div class="finder-heading-copy"><div class="eyebrow">TERMOMASTER · @L["Ընտրության օգնական"]</div><h1>@L["Գտնենք ճիշտ մասը"]<span aria-hidden="true">.</span></h1><p>@L["Կոդով, սարքի մոդելով կամ լուսանկարով՝ սկսենք այն տվյալից, որն ունեք։"]</p></div><div class="finder-heading-mark" aria-hidden="true"><i data-icon="search-check"></i><span>01<span>→</span>02<span>→</span>03</span></div></header>
    <div class="finder-workspace">
        <aside class="finder-overview"><span class="finder-overview-label">@L["Ձեր հաջորդ քայլը"]</span><ol class="finder-progress" aria-label="@L["Ընտրության քայլեր"]"><li data-finder-step="path" class="is-current"><span>01</span><div><strong>@L["Ընտրեք ճանապարհը"]</strong><small>@L["Ինչ տվյալ ունեք ձեռքի տակ"]</small></div></li><li data-finder-step="identify"><span>02</span><div><strong>@L["Տվեք մանրամասները"]</strong><small>@L["Կոդ, մոդել կամ լուսանկար"]</small></div></li><li data-finder-step="result"><span>03</span><div><strong>@L["Գտեք համապատասխան մասը"]</strong><small>@L["Դիտեք տարբերակը կամ դիմեք մեզ"]</small></div></li></ol><div class="finder-overview-note"><i data-icon="shield"></i><p>@L["Չգիտե՞ք բոլոր տվյալները։ Սկսեք ունեցածից․ անհրաժեշտության դեպքում մասնագետը կօգնի ճշտել համապատասխանությունը։"]</p></div></aside>
        <div class="finder-main">
            <section class="finder-paths" aria-labelledby="finder-path-title"><div class="finder-section-heading"><div><span class="eyebrow">01 · @L["Ընտրեք ճանապարհը"]</span><h2 id="finder-path-title">@L["Ինչպե՞ս է ձեզ հարմար գտնել"]</h2></div><a href="/find-part" class="finder-reset" data-finder-reset hidden="@(Model.Mode.Length == 0)">@L["Սկսել նորից"] <span aria-hidden="true">↺</span></a></div><div class="finder-path-grid">
                <a href="/find-part?mode=code" data-finder-mode="code" aria-current="@(Model.Mode == "code" ? "step" : null)" class="finder-path @(Model.Mode == "code" ? "is-selected" : "")"><span class="finder-path-icon"><i data-icon="search"></i></span><strong>@L["Գիտեմ կոդը կամ անունը"]</strong><small>@L["Որոնեք արտիկուլով կամ մասի անվանմամբ"]</small><span class="finder-path-arrow" aria-hidden="true">↗</span></a>
                <a href="/find-part?mode=model" data-finder-mode="model" aria-current="@(Model.Mode == "model" ? "step" : null)" class="finder-path @(Model.Mode == "model" ? "is-selected" : "")"><span class="finder-path-icon"><i data-icon="package"></i></span><strong>@L["Գիտեմ սարքի մոդելը"]</strong><small>@L["Ընտրեք սարքը և տեսեք կապված մասերը"]</small><span class="finder-path-arrow" aria-hidden="true">↗</span></a>
                <a href="/find-part?mode=photo" data-finder-mode="photo" aria-current="@(Model.Mode == "photo" ? "step" : null)" class="finder-path @(Model.Mode == "photo" ? "is-selected" : "")"><span class="finder-path-icon"><i data-icon="message"></i></span><strong>@L["Կարող եմ լուսանկար ուղարկել"]</strong><small>@L["Պիտակն ու դետալը կօգնեն մեր մասնագետին"]</small><span class="finder-path-arrow" aria-hidden="true">↗</span></a>
            </div></section>
            <section class="finder-panel" data-finder-panel="code" hidden="@(Model.Mode != "code")" aria-labelledby="finder-code-title"><div class="finder-section-heading"><div><span class="eyebrow">02 · @L["Մասի տվյալները"]</span><h2 id="finder-code-title" tabindex="-1" data-finder-focus>@L["Սկսենք կոդից կամ անվանումից"]</h2></div><span class="finder-panel-symbol" aria-hidden="true">⌕</span></div><form id="finder-code-form" action="/find-part" method="get"><input type="hidden" name="lang" value="@L.Language" /><input type="hidden" name="mode" value="code" /><label for="finder-query">@L["Արտիկուլ, փոխարինման կոդ կամ մասի անվանում"]</label><div class="finder-search"><input type="search" id="finder-query" name="q" value="@Model.Query" minlength="2" maxlength="200" autocomplete="off" placeholder="@L["Օրինակ՝ ՏԷՆ, անոդ կամ դետալի կոդը"]" aria-describedby="finder-search-help" /><button type="submit" class="btn">@L["Գտնել մասը"] <span aria-hidden="true">→</span></button></div><p id="finder-search-help" class="finder-field-help">@L["Կոդը սովորաբար նշված է դետալի կամ փաթեթավորման վրա։ Կարող եք գրել նաև անվանումը։"]</p></form></section>
            <section class="finder-panel" data-finder-panel="model" hidden="@(Model.Mode != "model")" aria-labelledby="finder-model-title"><div class="finder-section-heading"><div><span class="eyebrow">02 · @L["Սարքի տվյալները"]</span><h2 id="finder-model-title" tabindex="-1" data-finder-focus>@L["Ո՞ր սարքի համար եք փնտրում"]</h2></div><span class="finder-panel-symbol" aria-hidden="true">⊞</span></div><form id="finder-model-form" action="/find-part" method="get"><input type="hidden" name="lang" value="@L.Language" /><input type="hidden" name="mode" value="model" /><div class="finder-model-controls"><label>@L["Սարքի տեսակ"]<select id="finder-category" name="category"><option value="">@L["Բոլոր սարքերը"]</option>@foreach (var category in Model.DeviceCategories) { <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Title</option> }</select></label><label>@L["Սարքի բրենդ"]<select id="finder-brand" name="brand"><option value="">@L["Ընտրեք բրենդը"]</option>@foreach (var brand in Model.AvailableModels.Select(x => x.Brand).Distinct().OrderBy(x => x)) { <option value="@brand" selected="@(brand == Model.Brand)">@brand</option> }</select></label><label>@L["Սարքի մոդել"]<select id="finder-model" name="model"><option value="">@L["Ընտրեք մոդելը"]</option>@foreach (var equipment in Model.BrandModels.OrderBy(x => x.Series).ThenBy(x => x.Name)) { <option value="@equipment.Id" selected="@(equipment.Id == Model.ModelId)">@equipment.Series @equipment.Name</option> }</select></label></div><button type="submit" class="btn">@L["Ցույց տալ համապատասխան մասերը"] <span aria-hidden="true">→</span></button></form><div class="finder-model-help" data-finder-model-help hidden="@Model.Store.EquipmentModels.Any()"><i data-icon="search-check"></i><div><strong>@L["Ձեր մոդելը ցանկում չկա՞"]</strong><p>@L["Ուղարկեք սարքի պիտակի լուսանկարը։ Մասնագետը կօգնի ճշտել անհրաժեշտ պահեստամասը։"]</p><a href="/find-part?mode=photo" data-finder-mode="photo" class="text-link">@L["Շարունակել լուսանկարով"] →</a></div></div><p class="finder-field-help">@L["Մոդելի անվանումը գտեք սարքի տեխնիկական պիտակի վրա։ Ճշտեք նաև դետալի չափերն ու ամրացումը։"]</p></section>
            <section class="finder-panel" data-finder-panel="photo" hidden="@(Model.Mode != "photo")" aria-labelledby="finder-photo-title"><div class="finder-section-heading"><div><span class="eyebrow">02 · @L["Մասնագետի օգնությամբ"]</span><h2 id="finder-photo-title" tabindex="-1" data-finder-focus>@L["Ցույց տվեք սարքը․ կօգնենք ընտրել"]</h2></div><i data-icon="message"></i></div><p class="finder-photo-intro">@L["Պատրաստեք երկու հստակ լուսանկար։ Դրանք կտեսնի մեր մասնագետը՝ համապատասխանությունը ճշտելու համար։"]</p><div class="finder-photo-grid"><article><span class="finder-photo-number">01</span><div class="finder-device-illustration" aria-hidden="true"><span></span><i></i></div><h3>@L["Սարքի ընդհանուր տեսքը"]</h3><p>@L["Թող երևան սարքն ու միացումները։ Եթե հին դետալը հանված է, կարող եք ցույց տալ նաև այն։"]</p></article><article><span class="finder-photo-number">02</span><div class="finder-label-illustration" aria-hidden="true"><b>MODEL</b><span></span><span></span><i>▥ ▥▥ ▥ ▥▥</i></div><h3>@L["Տեխնիկական պիտակը՝ մոտիկից"]</h3><p>@L["Մոդելն ու տեխնիկական տվյալները պետք է հստակ ընթեռնելի լինեն։"]</p></article></div><button type="button" class="btn finder-photo-start" data-finder-photo-start hidden><i data-icon="message"></i>@L["Ուղարկել լուսանկարները մասնագետին"] <span aria-hidden="true">→</span></button><details class="finder-photo-fallback" data-finder-photo-fallback><summary>@L["Լրացնել լուսանկարով հարցումը"]</summary><form class="request-form" action="/api/leads" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="part" /><input type="hidden" name="subject" value="@L["Լուսանկարով պահեստամասի ընտրություն"]" /><input type="hidden" name="requestId" value="@Guid.NewGuid()" /><div class="form-grid"><label class="field">@L["Անուն *"]<input name="name" required minlength="2" maxlength="100" autocomplete="name" /></label><label class="field">@L["Հեռախոս *"]<input name="phone" type="tel" required maxlength="30" autocomplete="tel" /></label><label class="field full">@L["Մոդել կամ մասի կոդ"]<input name="model" maxlength="100" /></label><label class="field full">@L["Առաջին նկար՝ ընդհանուր տեսք"]<input name="attachment" type="file" accept="image/jpeg,image/png,image/webp" /></label><label class="field full">@L["Երկրորդ նկար՝ տեխնիկական պիտակ"]<input name="attachment2" type="file" accept="image/jpeg,image/png,image/webp" /></label><label class="field full">@L["Լրացուցիչ տեղեկություններ"]<textarea name="message" maxlength="3000"></textarea></label></div><label class="checkbox-line"><input name="consent" type="checkbox" value="true" required /><span>@L["Համաձայն եմ, որ իմ տվյալներն օգտագործվեն այս հայտի մշակման և ինձ հետ կապ հաստատելու համար։"] <a href="/privacy">@L["Գաղտնիության պայմաններ"]</a></span></label><p class="error-text" role="alert" hidden></p><button type="submit" class="btn">@L["Ուղարկել հայտը"]</button></form></details><p class="finder-field-help">@L["Հարցումը չի նշանակում հաստատված պատվեր․ նախ ճշտում ենք համապատասխանությունը։"]</p></section>
            <section class="finder-results" data-finder-results hidden="@(!Model.HasSelection || Model.Mode == "photo")" aria-labelledby="finder-results-title"><div class="finder-section-heading"><div><span class="eyebrow">03 · @L["Ձեր ընտրության արդյունքը"]</span><h2 id="finder-results-title" tabindex="-1">@L["Դիտեք համապատասխան տարբերակները"]</h2></div><p id="finder-result-count" role="status" aria-live="polite">@Model.ResultCount @L["ապրանք"]</p></div><p class="finder-match-note" data-finder-match-note>@(Model.Mode == "model" ? L["Ապրանքները կապված են ընտրված մոդելի հետ։ Համեմատեք նաև չափերն ու ամրացումը։"] : L["Սրանք որոնման արդյունքներն են։ Գնելուց առաջ համեմատեք մոդելը, չափերն ու ամրացումը։"])</p><div class="catalog-grid store-product-grid finder-products" id="finder-results">@foreach (var product in Model.Results) { <partial name="_ProductCard" model="product" /> }</div><div class="finder-no-results" data-finder-empty hidden="@(Model.ResultCount > 0)"><i data-icon="search"></i><h3>@L["Այս տվյալներով մաս չգտանք"]</h3><p>@L["Փորձեք այլ կոդ կամ ուղարկեք լուսանկար։ Մասնագետը կօգնի շարունակել ընտրությունը։"]</p><a href="/find-part?mode=photo" data-finder-mode="photo" class="btn btn-outline">@L["Շարունակել լուսանկարով"] →</a></div><a href="@(Model.Mode == "model" ? "/parts?model=" + Uri.EscapeDataString(Model.ModelId) : "/parts?q=" + Uri.EscapeDataString(Model.Query))" class="finder-more text-link" data-finder-more hidden="@(Model.ResultCount <= 12)">@L["Դիտել բոլոր արդյունքները"] →</a></section>
            <p class="finder-live-status" role="status" aria-live="polite" data-finder-status></p>
        </div>
    </div>
    <script type="application/json" id="finder-data">@Html.Raw(SiteJson.Serialize(new { products = Model.Products, categories = Model.Store.Categories, models = Model.Store.EquipmentModels }))</script>
</div>
@section Scripts { <script src="/js/part-finder.js" asp-append-version="true" defer></script> }
