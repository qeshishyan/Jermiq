@page "/admin/store"
@model Jermiq.Web.Pages.Admin.StoreModel
@{ Layout = "_OfficeLayout"; }
<div class="office-shell" id="store-admin-app">
<aside class="office-sidebar"><a class="office-brand" href="/admin"><img src="/logo.svg" alt="Jermiq" /><span>JERMIQ<small>@L["Կայքի կառավարում"]</small></span></a>
<nav class="office-nav store-side-nav" aria-label="@L["Կառավարման բաժիններ"]"><a href="/admin">← @L["Օֆիս և հայտեր"]</a><a href="/admin?section=products">@L["Ապրանքներ"]</a><a href="/admin/store" class="selected" aria-current="page">@L["Կատալոգի կառուցվածք"]</a><a href="/admin?section=settings">@L["Կոնտակտներ և պայմաններ"]</a><a href="/admin?section=translations">@L["Լեզուներ և տեքստեր"]</a></nav>
<div class="office-sidebar-bottom"><a href="/" target="_blank" rel="noopener">@L["Դիտել կայքը"] ↗</a><span class="office-role">@L["Ադմինիստրատոր"]</span><small>@User.Identity?.Name</small></div></aside>
<div class="office-workspace"><header class="office-top"><div><div class="eyebrow">JERMIQ / @L["Կայքի կառավարում"]</div><h1>@L["Կատալոգ և գլխավոր էջ"]</h1><span class="workspace-subtitle">@L["Կատեգորիաները, սարքերի մոդելներն ու կայքի բովանդակությունը՝ մեկ տեղում։"]</span></div><div class="actions"><partial name="_LanguageSwitch" /><button type="button" class="btn btn-outline" id="store-refresh">@L["Թարմացնել տվյալները"]</button><form action="/admin/logout" method="post">@Html.AntiForgeryToken()<button type="submit" class="plain-button">@L["Դուրս գալ"]</button></form></div></header>
<main id="main" class="office-main">
<p class="error-text store-alert" id="store-error" role="alert" hidden></p><p class="notice store-alert" id="store-notice" role="status" hidden></p>
<div class="store-admin-intro"><div><span class="eyebrow">@L["Խանութի կարգավորումներ"]</span><h2>@L["Կառուցեք ձեր կատալոգը"]</h2><p>@L["Փոփոխությունները պահպանվում են առանձին։ Ապրանքները և դրանց կապերը խմբագրեք «Ապրանքներ» բաժնից։"]</p></div><a href="/admin?section=products" class="btn btn-outline">@L["Ապրանքների կառավարում"] ↗</a></div>
<div class="store-admin-tabs" role="tablist" aria-label="@L["Խանութի բաժիններ"]"><button type="button" id="store-tab-categories" role="tab" aria-selected="true" aria-controls="store-panel-categories" data-store-tab="categories">@L["Կատեգորիաներ"] <span id="store-category-count"></span></button><button type="button" id="store-tab-models" role="tab" aria-selected="false" aria-controls="store-panel-models" data-store-tab="models" tabindex="-1">@L["Սարքերի մոդելներ"] <span id="store-model-count"></span></button><button type="button" id="store-tab-home" role="tab" aria-selected="false" aria-controls="store-panel-home" data-store-tab="home" tabindex="-1">@L["Գլխավոր էջ"]</button><button type="button" id="store-tab-information" role="tab" aria-selected="false" aria-controls="store-panel-information" data-store-tab="information" tabindex="-1">@L["Վճարում և մեր մասին"]</button></div>
<section id="store-panel-categories" role="tabpanel" aria-labelledby="store-tab-categories"><div class="store-manager-grid"><section class="store-browser"><div class="store-browser-heading"><h3>@L["Կատեգորիաների ծառ"]</h3><button type="button" class="btn" id="store-category-new">＋ @L["Ավելացնել"]</button></div><label class="field store-search-label"><span>@L["Որոնել կատեգորիա"]</span><input type="search" id="store-category-search" maxlength="200" placeholder="@L["Անվանում կամ կոդ"]" /></label><div id="store-categories-list" aria-live="polite"><p>@L["Բեռնվում է…"]</p></div></section>
<form id="store-category-form" class="office-editor store-config-editor" hidden><div class="editor-heading"><div><span class="eyebrow">@L["Կատեգորիայի խմբագրիչ"]</span><h3 id="store-category-editor-title"></h3></div><span class="draft-state" data-store-draft="store-category-form"></span></div><div class="form-grid"><label class="field full">@L["Անվանում"] *<input name="title" required minlength="2" maxlength="160" /></label><label class="field">@L["Կայուն կոդ"] *<input name="id" required pattern="[a-z0-9-]{2,80}" maxlength="80" /><small>@L["Պահպանված կոդը չի փոխվում՝ ապրանքների կապերը պահպանելու համար։"]</small></label><label class="field">@L["Վերադաս կատեգորիա"]<select name="parentId"></select></label><label class="field full">@L["Նկարագրություն"]<textarea name="description" maxlength="1500" rows="4"></textarea></label><label class="field">@L["Հերթականություն"]<input name="sortOrder" type="number" min="0" max="100000" value="0" required /></label><label class="field">@L["Նկարի հասցե"]<input name="image" maxlength="1000" placeholder="/images/parts.webp" /></label><label class="field full">@L["Բեռնել կատեգորիայի նկար"]<input type="file" accept="image/jpeg,image/png,image/webp" data-store-upload="image" /><small>JPEG / PNG / WebP · 5 MB</small></label><label class="checkbox-line full"><input type="checkbox" name="published" checked />@L["Հրապարակված է"]</label></div><div class="store-category-preview"><img id="store-category-image" alt="" width="160" height="110" hidden /><p id="store-category-usage"></p></div><div class="editor-footer"><button type="submit" class="btn">@L["Պահպանել կատեգորիան"]</button><button type="button" class="btn btn-outline store-danger" id="store-category-delete">@L["Հեռացնել"]</button></div></form></div></section>
<section id="store-panel-models" role="tabpanel" aria-labelledby="store-tab-models" hidden><p class="store-section-help">@L["Ավելացրեք սարքի իրական մոդելը։ Մոդելի հետ համատեղելի պահեստամասերը ընտրեք ապրանքի խմբագրիչում։"]</p><div class="store-manager-grid"><section class="store-browser"><div class="store-browser-heading"><h3>@L["Սարքերի մոդելներ"]</h3><button type="button" class="btn" id="store-model-new">＋ @L["Ավելացնել"]</button></div><label class="field store-search-label"><span>@L["Որոնել մոդել"]</span><input type="search" id="store-model-search" maxlength="200" placeholder="@L["Բրենդ, սերիա կամ մոդել"]" /></label><div id="store-models-list" aria-live="polite"></div></section>
<form id="store-model-form" class="office-editor store-config-editor" hidden><div class="editor-heading"><div><span class="eyebrow">@L["Սարքի մոդել"]</span><h3 id="store-model-editor-title"></h3></div><span class="draft-state" data-store-draft="store-model-form"></span></div><div class="form-grid"><label class="field full">@L["Մոդելի անվանում"] *<input name="name" required minlength="2" maxlength="200" /></label><label class="field">@L["Կայուն կոդ"] *<input name="id" required pattern="[a-z0-9-]{2,80}" maxlength="80" /></label><label class="field">@L["Սարքի կատեգորիա"] *<select name="categoryId" required></select></label><label class="field">@L["Բրենդ"] *<input name="brand" required maxlength="160" /></label><label class="field">@L["Սերիա"]<input name="series" maxlength="160" /></label><label class="checkbox-line full"><input type="checkbox" name="published" checked />@L["Հրապարակված է"]</label></div><p id="store-model-usage" class="store-section-help"></p><div class="editor-footer"><button type="submit" class="btn">@L["Պահպանել մոդելը"]</button><button type="button" class="btn btn-outline store-danger" id="store-model-delete">@L["Հեռացնել"]</button></div></form></div></section>
<section id="store-panel-home" role="tabpanel" aria-labelledby="store-tab-home" hidden><form id="store-home-form" class="office-editor store-content-editor"><div class="editor-heading"><div><span class="eyebrow">@L["Գլխավոր էջ"]</span><h3>@L["Գլխավորի բովանդակություն"]</h3></div><span class="draft-state" data-store-draft="store-home-form"></span></div><div class="form-grid"><div class="form-section-title full"><span>01</span><h3>@L["Գլխավոր առաջարկ"]</h3></div><label class="field full">@L["Վերնագրի վերևի տեքստ"]<input name="eyebrow" maxlength="160" /></label><label class="field full">@L["Գլխավոր վերնագիր"] *<input name="title" required minlength="2" maxlength="300" /></label><label class="field full">@L["Ներածություն"]<textarea name="intro" rows="4" maxlength="1500"></textarea></label><label class="field full">@L["Գլխավոր նկարի հասցե"]<input name="heroImage" maxlength="1000" /></label><label class="field full">@L["Բեռնել գլխավոր նկարը"]<input type="file" accept="image/jpeg,image/png,image/webp" data-store-upload="heroImage" /></label><div class="form-section-title full"><span>02</span><h3>@L["Ընտրության օգնություն"]</h3></div><label class="field full">@L["Լուսանկարով օգնության վերնագիր"]<input name="photoHelpTitle" maxlength="200" /></label><label class="field full">@L["Լուսանկարով օգնության տեքստ"]<textarea name="photoHelpText" maxlength="1500" rows="3"></textarea></label><div class="form-section-title full"><span>03</span><h3>@L["Ապրանքներ և գործընկերներ"]</h3></div><label class="field full">@L["Առաջարկվող ապրանքների վերնագիր"]<input name="featuredTitle" maxlength="160" /><small>@L["Ապրանքը այս ցանկում ներառելու համար միացրեք «Առաջարկվող» նշումը ապրանքի խմբագրիչում։"]</small></label><label class="field full">@L["Վարպետների և մեծածախ գնորդների վերնագիր"]<input name="wholesaleTitle" maxlength="200" /></label><label class="field full">@L["Վարպետների և մեծածախ գնորդների տեքստ"]<textarea name="wholesaleText" maxlength="1500" rows="4"></textarea></label></div><div class="editor-footer"><button type="submit" class="btn">@L["Պահպանել գլխավոր էջը"]</button><a href="/" target="_blank" rel="noopener" class="text-link">@L["Դիտել կայքը"] ↗</a></div></form></section>
<section id="store-panel-information" role="tabpanel" aria-labelledby="store-tab-information" hidden><form id="store-information-form" class="office-editor store-content-editor"><div class="editor-heading"><h3>@L["Տեղեկատվական էջեր"]</h3><span class="draft-state" data-store-draft="store-information-form"></span></div><p class="store-section-help">@L["Գրեք իրական ընդունվող վճարման եղանակները և ընկերության մասին հաստատված տեղեկությունները։ Առաքումն ու երաշխիքը խմբագրվում են «Կոնտակտներ և պայմաններ» բաժնում։"]</p><label class="field">@L["Վճարման պայմաններ"]<textarea name="paymentText" rows="9" maxlength="6000"></textarea></label><label class="field">@L["Մեր մասին"]<textarea name="aboutText" rows="9" maxlength="6000"></textarea></label><div class="editor-footer"><button type="submit" class="btn">@L["Պահպանել էջերը"]</button><a href="/admin?section=settings" class="text-link">@L["Առաքում, երաշխիք և կոնտակտներ"] →</a></div></form></section>
<p class="store-localization-help">@L["Նոր տեքստերի ռուսերեն և անգլերեն տարբերակները լրացրեք «Լեզուներ և տեքստեր» բաժնում։ Մոդելների կոդերը չեն թարգմանվում։"]</p>
</main><footer class="office-footer">JERMIQ CMS · @L["Կայքի կառավարում"]</footer></div></div>
