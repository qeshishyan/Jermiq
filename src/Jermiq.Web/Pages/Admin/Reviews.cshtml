@page "/admin/reviews"
@model Jermiq.Web.Pages.Admin.ReviewsModel
@{ Layout = "_OfficeLayout"; }
<link rel="stylesheet" href="/css/reviews.css" asp-append-version="true" />
<div class="office-shell" id="review-admin-app"><aside class="office-sidebar"><partial name="_OfficeBrand" /><nav class="office-nav" aria-label="@L["Կառավարման բաժիններ"]"><a href="/admin">← @L["Օֆիս և հայտեր"]</a><a href="/admin?section=products">@L["Ապրանքներ"]</a><a href="/admin/store">@L["Կատալոգի կառուցվածք"]</a><a href="/admin/orders">@L["Պատվերների կառավարում"]</a><a href="/admin/reviews" class="selected" aria-current="page">@L["Կարծիքների կառավարում"]</a></nav><div class="office-sidebar-bottom"><a href="/">@L["Դիտել կայքը"] ↗</a><span class="office-role">@L["Ադմինիստրատոր"]</span><small>@User.Identity?.Name</small></div></aside><div class="office-workspace"><header class="office-top"><div><span class="eyebrow">TERMOMASTER / @L["Կայքի կառավարում"]</span><h1>@L["Կարծիքների կառավարում"]</h1><p>@L["Ստուգեք գնորդների կարծիքները նախքան հրապարակելը։"]</p></div><div class="actions"><partial name="_LanguageSwitch" /><form action="/admin/logout" method="post">@Html.AntiForgeryToken()<button class="plain-button" type="submit">@L["Դուրս գալ"]</button></form></div></header><main id="main" class="office-main"><p id="review-admin-error" class="error-text" role="alert" hidden></p><p id="review-admin-notice" class="notice" role="status" hidden></p><section class="review-admin-toolbar"><label class="field">@L["Կարգավիճակ"]<select id="review-status-filter"><option value="pending">@L["Սպասում է ստուգման"]</option><option value="approved">@L["Հրապարակված է"]</option><option value="rejected">@L["Մերժված է"]</option><option value="all">@L["Բոլորը"]</option></select></label><p id="review-admin-count" role="status"></p><button type="button" class="btn btn-outline" id="review-admin-refresh">@L["Թարմացնել տվյալները"]</button></section><div id="review-admin-list" aria-live="polite"><p>@L["Բեռնվում է…"]</p></div><nav id="review-admin-pagination" class="review-pagination" aria-label="@L["Էջավորում"]" hidden><button type="button" class="btn btn-outline" id="review-admin-prev">← @L["Նախորդը"]</button><span id="review-admin-page"></span><button type="button" class="btn btn-outline" id="review-admin-next">@L["Հաջորդը"] →</button></nav></main></div></div>
@section Scripts { <script src="/js/reviews.js" asp-append-version="true" defer></script> }
