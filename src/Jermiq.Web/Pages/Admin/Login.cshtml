@page "/admin/login"
@model Jermiq.Web.Pages.Admin.LoginModel
<div class="container section"><div class="admin-card login-card"><h1 style="font-size:2rem">Կառավարման մուտք</h1><p class="mt-5">Մուտք գործեք ձեր կառավարչի տվյալներով։</p><form method="post"><input asp-for="ReturnUrl" type="hidden" /><div class="form-grid"><label class="field full">Էլ․ փոստ<input asp-for="Email" type="email" autocomplete="username" required /></label><label class="field full">Գաղտնաբառ<input asp-for="Password" type="password" autocomplete="current-password" required /></label></div>@if (Model.ErrorMessage is not null) { <p class="error-text" role="alert">@Model.ErrorMessage</p> }<button class="btn w-full mt-5" type="submit">Մուտք գործել</button></form></div></div>
