@page "/admin"
@model Jermiq.Web.Pages.Admin.IndexModel
@inject StaticContent SiteContent
<div class="container pb-16" id="admin-app"><partial name="_Heading" model="@(("Կառավարման բաժին", (string?)("Հայտեր, տեսականի և պայմաններ · " + User.Identity?.Name)))" />
<div class="actions mb-5"><button type="button" class="btn btn-outline" id="admin-refresh"><i data-icon="refresh"></i>Թարմացնել տվյալները</button><form action="/admin/logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline" type="submit">Դուրս գալ</button></form></div>
<p class="error-text" id="admin-error" role="alert" hidden></p><p class="notice" id="admin-notice" role="status" hidden></p>
<div class="admin-tabs" role="tablist" aria-label="Կառավարման բաժիններ"><button class="selected" type="button" role="tab" aria-selected="true" aria-controls="panel-leads" id="tab-leads" data-tab="leads">Հայտեր <span id="lead-total"></span></button><button type="button" role="tab" aria-selected="false" aria-controls="panel-products" id="tab-products" data-tab="products">Ապրանքներ</button><button type="button" role="tab" aria-selected="false" aria-controls="panel-settings" id="tab-settings" data-tab="settings">Կոնտակտներ և պայմաններ</button></div>
<section id="panel-leads" role="tabpanel" aria-labelledby="tab-leads"><div class="filter-bar"><select id="lead-filter" class="field-select" aria-label="Հայտի կարգավիճակ"><option value="all">Բոլոր հայտերը</option><option value="new">Նոր</option><option value="contacted">Կապ հաստատված</option><option value="completed">Ավարտված</option></select><span class="text-sm">Ցուցադրվում են վերջին 100 հայտերը</span></div><div id="leads-list"><p>Բեռնվում է…</p></div></section>
<section id="panel-products" role="tabpanel" aria-labelledby="tab-products" hidden><div class="actions mb-5"><button type="button" class="btn" id="product-new"><i data-icon="plus"></i>Ավելացնել ապրանք</button></div><div class="admin-grid"><div class="admin-list" id="product-list"></div><form class="admin-card" id="product-form"><h2 class="mb-5" style="font-size:1.4rem">Ապրանքի տվյալները</h2><div class="form-grid">
<label class="field full">Անվանում<input name="title" required minlength="2" maxlength="200" /></label><label class="field">Էջի հասցեի անուն (slug)<input name="slug" pattern="[a-z0-9-]{2,80}" required /><small>Անգլերեն փոքրատառեր, թվեր և գծիկներ։ Հրապարակումից հետո պահեք անփոփոխ։</small></label><label class="field">Բաժին<select name="category"><option value="heater">Ջրատաքացուցիչ</option><option value="part">Պահեստամաս</option></select></label>
<label class="field">Արտադրող<input name="brand" maxlength="200" /></label><label class="field">Մոդել / կոդ<input name="model" maxlength="200" /></label><label class="field">Գին՝ AMD<input name="price" type="number" min="0" max="1000000000" step="0.01" /><small>Դատարկ դաշտը նշանակում է՝ գինը ճշտվում է։</small></label><label class="field">Տարողություն՝ լ<input name="volume" type="number" min="1" max="2000" step="1" /></label><label class="field full">Առկայության նկարագրություն<input name="availability" maxlength="200" /></label><label class="field full">Նկարագրություն<textarea name="description" maxlength="6000"></textarea></label><label class="field full">Տեխնիկական տվյալներ (յուրաքանչյուր տողում՝ անվանում: արժեք)<textarea name="specs"></textarea></label><label class="field full">Իրական ապրանքի լուսանկար<input id="product-image-upload" type="file" accept="image/jpeg,image/png,image/webp" /></label><div class="field full"><img id="product-preview" alt="Ապրանքի ընթացիկ պատկերը" width="240" height="160" /></div></div><label class="checkbox-line"><input name="demo" type="checkbox" /><span>Ցուցադրական օրինակ (ոչ հաստատված ապրանք)</span></label><button class="btn" type="submit">Պահպանել ապրանքը</button></form></div></section>
<section id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" hidden><form class="admin-card prose" id="settings-form"><h2 class="mb-5">Կոնտակտներ և պայմաններ</h2><div class="form-grid"><label class="field">Հեռախոս<input name="phone" maxlength="50" /></label><label class="field">Էլ․ փոստ<input name="email" type="email" maxlength="200" /></label><label class="field">Հասցե / սպասարկման տարածք<input name="address" maxlength="500" /></label><label class="field">Աշխատանքային ժամեր<input name="hours" maxlength="300" /></label><label class="field full">Երաշխիքի պայմաններ<textarea name="warranty" maxlength="5000"></textarea></label><label class="field full">Առաքման պայմաններ<textarea name="delivery" maxlength="3000"></textarea></label>@foreach (var service in SiteContent.Services) { <label class="field">@service.Title՝ գնի նկարագրություն<input name="service-@service.Id" placeholder="Օրինակ՝ սկսած … ֏" maxlength="200" /></label> }</div><label class="checkbox-line"><input name="showDraftBanner" type="checkbox" /><span>Ցուցադրել նախնական տարբերակի նշումը</span></label><button class="btn mt-6" type="submit">Պահպանել պայմանները</button></form></section>
</div>
@section Scripts { <script src="/js/admin.js" asp-append-version="true" defer></script> }
