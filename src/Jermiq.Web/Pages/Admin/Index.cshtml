@page "/admin"
@model Jermiq.Web.Pages.Admin.IndexModel
@inject StaticContent SiteContent
@{ var isAdmin = User.IsInRole("Admin"); }
<div class="office-shell" id="admin-app" data-is-admin="@isAdmin.ToString().ToLowerInvariant()">
<aside class="office-sidebar"><a class="office-brand" href="/admin"><img src="/logo.svg" alt="Jermiq" /><span>JERMIQ<small>@L["Office workspace"]</small></span></a>
<div class="office-nav" role="tablist" aria-label="@L["Կառավարման բաժիններ"]" aria-orientation="vertical">
<div class="nav-caption">@L["Daily workspace"]</div><button type="button" role="tab" aria-selected="false" aria-controls="panel-dashboard" id="tab-dashboard" data-tab="dashboard"><i data-icon="home"></i>@L["Overview"]</button>
<button class="selected" type="button" role="tab" aria-selected="true" aria-controls="panel-leads" id="tab-leads" data-tab="leads"><i data-icon="message"></i>@L["Հայտեր"] <span id="lead-total"></span></button>
@if (isAdmin) {
<div class="nav-caption">@L["Website management"]</div>
<button type="button" role="tab" aria-selected="false" aria-controls="panel-products" id="tab-products" data-tab="products"><i data-icon="package"></i>@L["Ապրանքներ"]</button>
<button type="button" role="tab" aria-selected="false" aria-controls="panel-settings" id="tab-settings" data-tab="settings"><i data-icon="phone"></i>@L["Կոնտակտներ և պայմաններ"]</button>
<button type="button" role="tab" aria-selected="false" aria-controls="panel-content" id="tab-content" data-tab="content"><i data-icon="book"></i>@L["Articles and services"]</button>
<button type="button" role="tab" aria-selected="false" aria-controls="panel-translations" id="tab-translations" data-tab="translations"><i data-icon="home"></i>@L["Languages and site copy"]</button>
<button type="button" role="tab" aria-selected="false" aria-controls="panel-users" id="tab-users" data-tab="users"><i data-icon="users"></i>@L["Team and access"]</button>
}
</div><div class="office-sidebar-bottom"><a href="/" target="_blank" rel="noopener">@L["View website"] ↗</a><span class="office-role">@(isAdmin ? L["Administrator"] : L["Office employee"])</span><small>@User.Identity?.Name</small></div></aside>
<div class="office-workspace"><header class="office-top"><div><div class="eyebrow">JERMIQ / @L["Operations"]</div><h1 id="workspace-title" tabindex="-1">@L["Request desk"]</h1><span id="workspace-subtitle" class="workspace-subtitle"></span></div><div class="actions"><partial name="_LanguageSwitch" /><button type="button" class="btn btn-outline" id="arrival-sound" aria-pressed="false">@L["Enable sound"]</button><button type="button" class="btn btn-outline" id="admin-refresh"><i data-icon="refresh"></i>@L["Թարմացնել տվյալները"]</button><form action="/admin/logout" method="post">@Html.AntiForgeryToken()<button class="plain-button" type="submit">@L["Դուրս գալ"]</button></form></div></header>
<main id="main" class="office-main"><p class="error-text" id="admin-error" role="alert" hidden></p><p class="notice" id="admin-notice" role="status" hidden></p>
<div class="arrival-banner" id="arrival-banner" hidden><span id="arrival-message" role="status" aria-live="polite"></span><button type="button" class="btn btn-outline" id="arrival-open">@L["View new requests"]</button></div>
<div class="workspace-status"><span class="status-dot"></span><p id="arrival-connection" class="text-xs" role="status"></p><span id="last-synced" class="text-xs"></span></div>
<section id="panel-dashboard" role="tabpanel" aria-labelledby="tab-dashboard" hidden>
<div class="overview-welcome"><div><span class="eyebrow">@L["Daily workspace"]</span><h2>@L["Your work at a glance"]</h2><p>@L["Track requests, deadlines and the catalog from one place."]</p></div><button type="button" class="btn" data-quick="new-lead"><i data-icon="plus"></i>@L["New request"]</button></div>
<div class="overview-metrics" id="dashboard-metrics"></div>
<div class="overview-grid"><section class="workspace-card"><div class="card-heading"><div><h3>@L["Recent requests"]</h3><p>@L["The latest activity from the website and office."]</p></div><button type="button" class="text-link plain-button" data-quick="leads">@L["All requests"] →</button></div><div id="dashboard-recent"></div></section>
<section class="workspace-card"><div class="card-heading"><h3>@L["Needs attention"]</h3></div><div id="dashboard-attention"></div><div class="workspace-tip"><i data-icon="shield"></i><p>@L["New arrivals keep updating while you work. Your unsaved edits stay safe."]</p></div></section></div>
@if (isAdmin) { <section class="workspace-card catalog-health"><div class="card-heading"><div><h3>@L["Catalog readiness"]</h3><p>@L["Find incomplete product data before publishing."]</p></div><button type="button" class="text-link plain-button" data-quick="products">@L["Manage catalog"] →</button></div><div id="dashboard-catalog"></div></section> }
</section>
<section id="panel-leads" role="tabpanel" aria-labelledby="tab-leads">
<div class="office-stats" id="office-stats"></div>
<div class="office-toolbar"><div><h2>@L["Request desk"]</h2><p>@L["Website and office requests in one workspace."]</p></div><div class="actions"><a class="btn btn-outline" id="lead-export" href="/api/admin/export">CSV ↓</a><button class="btn" type="button" id="lead-new"><i data-icon="plus"></i>@L["New request"]</button></div></div>
<form id="lead-search-form" class="office-filters"><label class="office-filter-control office-filter-search"><span>@L["Search requests"]</span><input class="field-input" id="lead-search" placeholder="@L["Search name, phone, request number…"]" aria-label="@L["Search requests"]" maxlength="200" /></label><label class="office-filter-control"><span>@L["Հայտի կարգավիճակ"]</span><select id="lead-filter" class="field-select" aria-label="@L["Հայտի կարգավիճակ"]"><option value="all">@L["Բոլոր հայտերը"]</option></select></label><label class="office-filter-control"><span>@L["Request type"]</span><select id="lead-kind-filter" class="field-select" aria-label="@L["Request type"]"><option value="all">@L["All types"]</option></select></label><button class="btn btn-outline" type="submit">@L["Որոնել"]</button><button class="plain-button text-link" type="button" id="lead-filters-reset">@L["Reset filters"]</button></form>
<details class="advanced-filters"><summary>@L["More filters"]</summary><div class="office-filters"><label class="field">@L["Priority"]<select id="lead-priority-filter" class="field-select"><option value="all">@L["All priorities"]</option><option value="urgent">@L["Urgent"]</option><option value="high">@L["High"]</option><option value="normal">@L["Normal"]</option><option value="low">@L["Low"]</option></select></label><label class="field">@L["Assignee"]<select id="lead-assignee-filter" class="field-select"><option value="all">@L["All employees"]</option><option value="__unassigned">@L["Unassigned"]</option></select></label><label class="field">@L["Channel"]<select id="lead-source-filter" class="field-select"><option value="all">@L["All channels"]</option><option value="website">@L["Website"]</option><option value="phone">@L["Phone call"]</option><option value="office">@L["Office visit"]</option><option value="email">@L["Էլ․ փոստ"]</option><option value="other">@L["Other"]</option></select></label><label class="field">@L["Due date"]<select id="lead-due-filter" class="field-select"><option value="all">@L["All deadlines"]</option><option value="overdue">@L["Overdue"]</option></select></label><label class="field">@L["Sort"]<select id="lead-sort" class="field-select"><option value="newest">@L["Newest first"]</option><option value="oldest">@L["Oldest first"]</option></select></label></div></details>
<div class="request-selection"><label class="checkbox-line"><input type="checkbox" id="lead-select-page" />@L["Select this page"]</label><span id="lead-results-count"></span><div id="lead-bulk" class="actions" hidden><strong id="lead-selected-count"></strong><select id="lead-bulk-status" class="field-select" aria-label="@L["Հայտի կարգավիճակ"]"></select><button type="button" class="btn btn-outline" id="lead-bulk-apply">@L["Apply status"]</button><button type="button" class="plain-button text-link" id="lead-selection-clear">@L["Clear selection"]</button></div></div>
<div class="office-request-grid"><div><div id="leads-list" aria-live="polite"><p>@L["Բեռնվում է…"]</p></div><div class="office-pagination"><button type="button" class="btn btn-outline" id="lead-prev">← @L["Նախորդը"]</button><span id="lead-page" aria-live="polite"></span><button type="button" class="btn btn-outline" id="lead-next">@L["Next"] →</button></div></div>
<section class="office-editor" id="lead-editor" hidden><div class="office-toolbar"><h2 id="lead-editor-title">@L["New request"]</h2><button type="button" class="icon-btn" id="lead-close" aria-label="@L["Close editor"]">×</button></div><div class="record-state"><span class="office-badge" id="lead-status-label"></span><span class="draft-state" data-dirty-for="lead-form"></span></div><form id="lead-form"><div class="form-grid">
<div class="form-section-title full"><span>01</span><h3>@L["Intake details"]</h3></div><label class="field">@L["Request type"] *<input name="kind" list="lead-types" maxlength="20" required minlength="2" /><datalist id="lead-types"><option value="service" label="@L["Սպասարկում"]"></option><option value="question" label="@L["Question"]"></option><option value="part" label="@L["Պահեստամաս"]"></option><option value="order" label="@L["Order"]"></option><option value="callback" label="@L["Callback"]"></option></datalist><small>@L["Choose a type or enter your own."]</small></label>
<label class="field">@L["Channel"]<select name="source"><option value="phone">@L["Phone call"]</option><option value="office">@L["Office visit"]</option><option value="email">@L["Էլ․ փոստ"]</option><option value="website">@L["Website"]</option><option value="other">@L["Other"]</option></select></label>
<div class="form-section-title full"><span>02</span><h3>@L["Customer and equipment"]</h3></div><label class="field full">@L["Անուն *"]<input name="name" required minlength="2" maxlength="100" /></label><label class="field">@L["Հեռախոս"]<input name="phone" type="tel" maxlength="30" /></label><label class="field">@L["Էլ․ փոստ"]<input name="email" type="email" maxlength="200" /></label>
<label class="field full">@L["Subject"]<input name="subject" maxlength="200" /></label><label class="field">@L["Արտադրող"]<input name="brand" maxlength="100" /></label><label class="field">@L["Մոդել / կոդ"]<input name="model" maxlength="100" /></label><label class="field full">@L["Address"]<input name="address" maxlength="500" /></label>
<label class="field full">@L["Customer message"]<textarea name="message" maxlength="3000"></textarea></label><label class="field full">@L["Order / technical details"]<textarea name="selection" maxlength="6000"></textarea></label>
<div class="form-section-title full"><span>03</span><h3>@L["Workflow and follow-up"]</h3></div><label class="field">@L["Հայտի կարգավիճակ"]<select name="status"></select></label><label class="field">@L["Priority"]<select name="priority"><option value="low">@L["Low"]</option><option value="normal">@L["Normal"]</option><option value="high">@L["High"]</option><option value="urgent">@L["Urgent"]</option></select></label>
<label class="field">@L["Assignee"]<select name="assignee"></select></label><label class="field">@L["Due date"]<input name="dueAt" type="datetime-local" /><small>@L["Your local time"]</small></label>
<label class="field full">@L["Add internal note"]<textarea name="note" maxlength="3000"></textarea><small>@L["Internal notes are visible only to the office team."]</small></label>
</div><div class="editor-footer"><button class="btn" type="submit">@L["Save request"]</button><span id="lead-reference" class="text-xs"></span></div></form>
<div id="lead-attachment-area" hidden><label class="field mt-5">@L["Կցել լուսանկար"]<input id="lead-attachment" type="file" accept="image/jpeg,image/png,image/webp" /></label><a id="lead-label-link" class="text-link" hidden>@L["Տեխնիկական պիտակի լուսանկար"]</a><a id="lead-attachment-link" class="text-link" hidden>@L["Download attachment"]</a></div>
<div class="office-timeline"><h3>@L["Internal notes"]</h3><div id="lead-notes"></div><h3>@L["Activity history"]</h3><div id="lead-history"></div></div></section></div>
</section>
@if (isAdmin) {
<section id="panel-products" role="tabpanel" aria-labelledby="tab-products" hidden>
<div class="office-toolbar"><div><h2>@L["Product catalog"]</h2><p>@L["Manage product details, prices, images and availability."]</p></div><button type="button" class="btn" id="product-new"><i data-icon="plus"></i>@L["Ավելացնել ապրանք"]</button></div>
<div class="catalog-metrics" id="product-metrics"></div>
<div class="office-filters"><label class="office-filter-control office-filter-search"><span>@L["Search products"]</span><input id="product-search" class="field-input" placeholder="@L["Search title, model or code…"]" aria-label="@L["Search products"]" /></label><label class="office-filter-control"><span>@L["Բաժին"]</span><select id="product-category-filter" class="field-select" aria-label="@L["Բաժին"]"><option value="all">@L["All categories"]</option><option value="heater">@L["Ջրատաքացուցիչներ"]</option><option value="part">@L["Պահեստամասեր"]</option></select></label><label class="office-filter-control"><span>@L["Catalog readiness"]</span><select id="product-state-filter" class="field-select" aria-label="@L["Catalog readiness"]"><option value="all">@L["All products"]</option><option value="real">@L["Real products"]</option><option value="demo">@L["Demonstration examples"]</option><option value="no-price">@L["Missing price"]</option><option value="no-description">@L["Missing description"]</option></select></label><label class="office-filter-control"><span>@L["Sort"]</span><select id="product-sort" class="field-select" aria-label="@L["Sort"]"><option value="title">@L["By title"]</option><option value="price">@L["Price ascending"]</option></select></label></div>
<div class="management-split"><div class="catalog-browser"><p id="product-count" class="result-caption" aria-live="polite"></p><div id="product-list" class="product-management-list"></div><div class="office-pagination"><button type="button" class="btn btn-outline" id="product-prev">←</button><span id="product-page"></span><button type="button" class="btn btn-outline" id="product-next">→</button></div></div>
<form class="office-editor product-editor" id="product-form" hidden><div class="editor-heading"><div><span class="eyebrow">@L["Product editor"]</span><h2 id="product-editor-title">@L["Ապրանքի տվյալները"]</h2></div><button type="button" class="icon-btn" id="product-close" aria-label="@L["Close editor"]">×</button></div><div class="record-state"><span class="office-badge" id="product-status-label"></span><span class="draft-state" data-dirty-for="product-form"></span></div>
<div class="product-media"><img id="product-preview" alt="@L["Ապրանքի ընթացիկ պատկերը"]" width="240" height="160" /><label class="field">@L["Իրական ապրանքի լուսանկար"]<input id="product-image-upload" multiple type="file" accept="image/jpeg,image/png,image/webp" /><small>JPEG / PNG / WebP · 5 MB · առավելագույնը՝ 12 նկար</small></label></div><div id="product-gallery-editor" class="gallery-thumbs"></div><label class="field">@L["Որոնման բանալի բառեր"]<input name="keywords" maxlength="1000" placeholder="@L["Հոմանիշներ, այլ անվանումներ, մասի կոդեր"]" /></label>
<div class="form-grid"><div class="form-section-title full"><span>01</span><h3>@L["Identity and category"]</h3></div><label class="field full">@L["Անվանում"]<input name="title" required minlength="2" maxlength="200" /></label><label class="field">@L["Էջի հասցեի անուն (slug)"]<input name="slug" pattern="[a-z0-9-]{2,80}" required /><small>@L["Existing page addresses are protected to preserve links."]</small></label><label class="field">@L["Բաժին"]<select name="category"><option value="heater">@L["Ջրատաքացուցիչ"]</option><option value="part">@L["Պահեստամաս"]</option></select></label><label class="field">@L["Արտադրող"]<input name="brand" maxlength="200" /></label><label class="field">@L["Մոդել / կոդ"]<input name="model" maxlength="200" /></label>
<div class="form-section-title full"><span>02</span><h3>@L["Price and availability"]</h3></div><label class="field">@L["Գին՝ AMD"]<input name="price" type="number" min="0" max="1000000000" step="0.01" /><small>@L["Դատարկ դաշտը նշանակում է՝ գինը ճշտվում է։"]</small></label><label class="field">@L["Տարողություն՝ լ"]<input name="volume" type="number" min="1" max="2000" step="1" /></label><label class="field full">@L["Առկայության նկարագրություն"]<input name="availability" maxlength="200" /></label>
<div class="form-section-title full"><span>03</span><h3>@L["Description and specifications"]</h3></div><label class="field full">@L["Նկարագրություն"]<textarea name="description" maxlength="6000" rows="5"></textarea></label><label class="field full">@L["Տեխնիկական տվյալներ (յուրաքանչյուր տողում՝ անվանում: արժեք)"]<textarea name="specs" rows="5"></textarea></label></div><label class="checkbox-line"><input name="demo" type="checkbox" /><span>@L["Ցուցադրական օրինակ (ոչ հաստատված ապրանք)"]</span></label>
<div class="editor-footer"><a id="product-public-link" class="text-link" target="_blank" rel="noopener">@L["Preview product"] ↗</a><button type="button" class="btn btn-outline" id="product-reset">@L["Reset changes"]</button><button class="btn" type="submit">@L["Պահպանել ապրանքը"]</button></div></form></div></section>
<section id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" hidden><form class="admin-card prose" id="settings-form"><div class="editor-heading"><div><h2>@L["Կոնտակտներ և պայմաններ"]</h2><p>@L["Keep customer-facing information accurate and consistent."]</p></div><span class="draft-state" data-dirty-for="settings-form"></span></div><div class="form-grid"><div class="form-section-title full"><span>01</span><h3>@L["Contact information"]</h3></div><label class="field">@L["Հեռախոս"]<input name="phone" maxlength="50" /></label><label class="field">@L["Էլ․ փոստ"]<input name="email" type="email" maxlength="200" /></label><label class="field">@L["Հասցե / սպասարկման տարածք"]<input name="address" maxlength="500" /></label><label class="field">@L["Աշխատանքային ժամեր"]<input name="hours" maxlength="300" /></label><div class="form-section-title full"><span>02</span><h3>@L["Delivery and warranty"]</h3></div><label class="field full">@L["Երաշխիքի պայմաններ"]<textarea name="warranty" maxlength="5000"></textarea></label><label class="field full">@L["Առաքման պայմաններ"]<textarea name="delivery" maxlength="3000"></textarea></label><div class="form-section-title full"><span>03</span><h3>@L["Service pricing"]</h3></div>@foreach (var service in SiteContent.Services) { <label class="field">@service.Title@L["՝ գնի նկարագրություն"]<input name="service-@service.Id" placeholder="@L["Օրինակ՝ սկսած … ֏"]" maxlength="200" /></label> }</div><input name="showDraftBanner" type="checkbox" hidden aria-hidden="true" tabindex="-1" /><div class="editor-footer"><button class="btn" type="submit">@L["Պահպանել պայմանները"]</button></div></form></section>}
@if (isAdmin) {
<section id="panel-translations" role="tabpanel" aria-labelledby="tab-translations" hidden><div class="office-toolbar"><div><h2>@L["Languages and site copy"]</h2><p>@L["Edit all three languages. Model codes and technical specifications stay unchanged."]</p></div><button class="btn" type="button" id="translations-save">@L["Save translations"] <span id="translation-dirty"></span></button></div><div class="office-filters"><input id="translation-search" class="field-input" placeholder="@L["Search site copy…"]" aria-label="@L["Search site copy…"]" /><select id="translation-filter" class="field-select" aria-label="@L["Translation coverage"]"><option value="all">@L["All text"]</option><option value="missing">@L["Missing translations"]</option></select><span id="translation-summary"></span></div><div id="translation-list"></div><div class="office-pagination"><button class="btn btn-outline" type="button" id="translation-prev">←</button><span id="translation-page"></span><button class="btn btn-outline" type="button" id="translation-next">→</button></div></section>
<section id="panel-content" role="tabpanel" aria-labelledby="tab-content" hidden><div class="office-toolbar"><div><h2>@L["Articles and services"]</h2><p>@L["Save the source content, then translate it in Languages and site copy."]</p></div></div><div class="office-filters"><input id="content-search" class="field-input" placeholder="@L["Search content…"]" aria-label="@L["Search content…"]" /><select id="content-type" class="field-select" aria-label="@L["Content type"]"><option value="articles">@L["Օգտակար նյութեր"]</option><option value="services">@L["Services"]</option></select><button type="button" class="btn" id="content-new">@L["Add content"]</button></div><div class="admin-grid"><div id="content-list" class="admin-list"></div><form id="content-form" class="office-editor"><div class="editor-heading"><h3>@L["Content editor"]</h3><span class="draft-state" data-dirty-for="content-form"></span></div><div class="form-grid"><label class="field full">@L["Stable identifier"]<input name="key" required pattern="[a-z0-9-]{2,80}" maxlength="80" /></label><label class="field full">@L["Անվանում"]<input name="title" required maxlength="200" /></label><label class="field full">@L["Introduction / description"]<textarea name="intro" maxlength="6000"></textarea></label></div><div id="content-sections"></div><button type="button" class="btn btn-outline" id="section-add">@L["Add section"]</button><div class="actions mt-5"><button type="submit" class="btn">@L["Save content"]</button><button type="button" class="btn btn-outline" id="content-delete">@L["Remove content"]</button></div></form></div></section>
<section id="panel-users" role="tabpanel" aria-labelledby="tab-users" hidden><div class="office-toolbar"><div><h2>@L["Team and access"]</h2><p>@L["Office employees manage requests. Administrators also manage content and team access."]</p></div><button type="button" class="btn" id="user-new">@L["Add employee"]</button></div><div class="office-filters"><input id="user-search" class="field-input" placeholder="@L["Search employees…"]" aria-label="@L["Search employees…"]" /><select id="user-filter" class="field-select" aria-label="@L["Role"]"><option value="all">@L["All employees"]</option><option value="Admin">@L["Administrator"]</option><option value="Office">@L["Office employee"]</option><option value="disabled">@L["Disabled"]</option></select><span id="user-count"></span></div><div class="admin-grid"><div class="admin-list" id="user-list"></div><form id="user-form" class="office-editor"><div class="editor-heading"><h3>@L["Employee access"]</h3><span class="draft-state" data-dirty-for="user-form"></span></div><div class="form-grid"><label class="field full">@L["Էլ․ փոստ"]<input name="email" type="email" required maxlength="200" /></label><label class="field full">@L["Գաղտնաբառ"]<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="200" /><small>@L["At least 12 characters with uppercase, lowercase, number and symbol. Leave blank to keep an existing password."]</small></label><label class="field full">@L["Role"]<select name="role"><option value="Office">@L["Office employee"]</option><option value="Admin">@L["Administrator"]</option></select></label></div><label class="checkbox-line"><input name="disabled" type="checkbox" />@L["Disable account"]</label><button type="submit" class="btn mt-5">@L["Save employee"]</button></form></div></section>
}
</main><footer class="office-footer">JERMIQ CMS · @L["Private office workspace"]</footer></div></div>
@section Scripts { <script src="/js/arrivals.js" asp-append-version="true" defer></script><script src="/js/admin.js" asp-append-version="true" defer></script> }
